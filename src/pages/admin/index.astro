      status: 'Onaylandı'
    },
    {
      id: 'app_seed_5',
      code: '#FR-KM-2026-5120',
      date: new Date(Date.now() - 1000 * 60 * 60 * 48).toISOString(), // 2 days ago
      name: 'Kemal Arslan',
      phone: '0 (542) 778 33 20',
      email: 'kemal.arslan@bursarest.com',
      city: 'Bursa',
      district: 'Nilüfer',
      budget: '1.5m-2.5m',
      locationType: 'cadde',
      experience: 'var',
      message: 'Görükle yerleşkesi veya Özlüce aksında yatırım düşünüyoruz.',
      status: 'Yeni'
    },
    {
      id: 'app_seed_6',
      code: '#FR-KM-2026-4401',
      date: new Date(Date.now() - 1000 * 60 * 60 * 72).toISOString(), // 3 days ago
      name: 'Tolga Çetin',
      phone: '0 (536) 918 40 12',
      email: 'tolga.cetin@akdenizgroup.com',
      city: 'Antalya',
      district: 'Muratpaşa',
      budget: '4m-plus',
      locationType: 'avm',
      experience: 'var',
      message: 'Lara veya Terracity çevresinde fast-casual makarna konsepti için ana franchise sözleşmesi yapmak istiyoruz.',
      status: 'Görüşme Planlandı'
    }
  ];

  class AdminManager {
    private applications: Application[] = [];
    private currentFilterCity = 'all';
    private currentFilterStatus = 'all';
    private currentSearch = '';
    private activeAppForModal: Application | null = null;

    constructor() {
      this.initAuth();
      this.bindEvents();
    }

    private initAuth() {
      const isAuth = sessionStorage.getItem('km_admin_auth') === 'authenticated';
      if (isAuth) {
        this.showDashboard();
      } else {
        this.showLogin();
      }
    }

    private showLogin() {
      document.getElementById('login-screen')?.classList.remove('hidden');
      document.getElementById('dashboard-screen')?.classList.add('hidden');
    }

    private showDashboard() {
      document.getElementById('login-screen')?.classList.add('hidden');
      document.getElementById('dashboard-screen')?.classList.remove('hidden');
      this.loadApplications();
      this.updateClock();
    }

    private loadApplications() {
      try {
        const stored = localStorage.getItem('km_franchise_applications');
        if (stored) {
          this.applications = JSON.parse(stored);
        } else {
          this.applications = [...DEFAULT_APPLICATIONS];
          localStorage.setItem('km_franchise_applications', JSON.stringify(this.applications));
        }
      } catch (err) {
        console.warn('LocalStorage load failed, using default', err);
        this.applications = [...DEFAULT_APPLICATIONS];
      }
      this.render();
    }

    private saveApplications() {
      try {
        localStorage.setItem('km_franchise_applications', JSON.stringify(this.applications));
      } catch (err) {
        console.warn('LocalStorage save failed', err);
      }
      this.render();
    }

    private bindEvents() {
      // PIN Form submit
      const pinForm = document.getElementById('pin-form') as HTMLFormElement | null;
      pinForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const pinInput = (document.getElementById('admin-pin') as HTMLInputElement)?.value.trim();
        const loginError = document.getElementById('login-error');

        // Simple default PIN: km2026
        if (pinInput.toLowerCase() === 'km2026') {
          sessionStorage.setItem('km_admin_auth', 'authenticated');
          loginError?.classList.add('hidden');
          this.showDashboard();
        } else {
          loginError?.classList.remove('hidden');
        }
      });

      // Logout button
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        sessionStorage.removeItem('km_admin_auth');
        this.showLogin();
      });

      // Search input
      document.getElementById('search-input')?.addEventListener('input', (e) => {
        this.currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
        this.renderTable();
      });

      // City filter
      document.getElementById('filter-city')?.addEventListener('change', (e) => {
        this.currentFilterCity = (e.target as HTMLSelectElement).value;
        this.renderTable();
      });

      // Status filter
      document.getElementById('filter-status')?.addEventListener('change', (e) => {
        this.currentFilterStatus = (e.target as HTMLSelectElement).value;
        this.renderTable();
      });

      // Reset mock data
      document.getElementById('reset-mock-btn')?.addEventListener('click', () => {
        if (confirm('Demo başvuru verileri varsayılana döndürülsün mü?')) {
          this.applications = [...DEFAULT_APPLICATIONS];
          this.saveApplications();
        }
      });

      // Simulate live lead button (Müşteri sunumu için canlı demo)
      document.getElementById('simulate-lead-btn')?.addEventListener('click', () => {
        const candidates = [
          { city: 'Samsun', district: 'Atakum Sahil', loc: 'sahil', name: 'Batuhan Koç' },
          { city: 'İstanbul', district: 'Beşiktaş Çarşı', loc: 'cadde', name: 'Zeynep Aksoy' },
          { city: 'Ankara', district: 'Tunalı Hilmi', loc: 'cadde', name: 'Mert Kayra' },
          { city: 'İzmir', district: 'Karşıyaka İskele', loc: 'sahil', name: 'Cemre Deniz' },
        ];
        const sample = candidates[Math.floor(Math.random() * candidates.length)];
        const randNum = Math.floor(1000 + Math.random() * 9000);
        const newLead: Application = {
          id: 'app_sim_' + Date.now(),
          code: `#FR-KM-2026-${randNum}`,
          date: new Date().toISOString(),
          name: sample.name,
          phone: `0 (53${Math.floor(1 + Math.random() * 9)}) ${Math.floor(100 + Math.random() * 900)} ${Math.floor(10 + Math.random() * 90)} ${Math.floor(10 + Math.random() * 90)}`,
          email: `${sample.name.toLowerCase().replace(/ /g, '.')}@gmail.com`,
          city: sample.city,
          district: sample.district,
          budget: '4m-plus',
          locationType: sample.loc,
          experience: 'var',
          message: 'Canlı sunum sırasında sistem üzerinden test amaçlı simüle edilmiş yüksek bütçeli yatırımcı başvurusu.',
          status: 'Yeni'
        };

        this.applications.unshift(newLead);
        this.saveApplications();
      });

      // Export CSV
      document.getElementById('export-csv-btn')?.addEventListener('click', () => {
        this.exportToCSV();
      });

      // Close modal
      document.getElementById('close-modal-btn')?.addEventListener('click', () => {
        this.closeModal();
      });

      // Modal status change
      document.getElementById('modal-status-select')?.addEventListener('change', (e) => {
        const newStatus = (e.target as HTMLSelectElement).value as Application['status'];
        if (this.activeAppForModal) {
          this.updateAppStatus(this.activeAppForModal.id, newStatus);
        }
      });
    }

    private updateClock() {
      const el = document.getElementById('live-time-display');
      if (!el) return;
      const now = new Date();
      el.textContent = `${now.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })} • ${now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`;
    }

    private render() {
      this.renderKPIs();
      this.renderTable();
    }

    private renderKPIs() {
      const totalEl = document.getElementById('metric-total');
      const newEl = document.getElementById('metric-new');
      const progressEl = document.getElementById('metric-progress');
      const capitalEl = document.getElementById('metric-capital');

      const total = this.applications.length;
      const newCount = this.applications.filter(a => a.status === 'Yeni').length;
      const progressCount = this.applications.filter(a => a.status === 'Görüşme Planlandı' || a.status === 'Değerlendirmede' || a.status === 'Onaylandı').length;

      // Estimate capital
      let totalMil = 0;
      this.applications.forEach(a => {
        if (a.budget === '4m-plus') totalMil += 4.5;
        else if (a.budget === '2.5m-4m') totalMil += 3.25;
        else totalMil += 2.0;
      });

      if (totalEl) totalEl.textContent = total.toString();
      if (newEl) newEl.textContent = newCount.toString();
      if (progressEl) progressEl.textContent = progressCount.toString();
      if (capitalEl) capitalEl.textContent = `₺${totalMil.toFixed(1)}M`;
    }

    private renderTable() {
      const tbody = document.getElementById('applications-table-body');
      const emptyState = document.getElementById('table-empty-state');
      if (!tbody) return;

      const filtered = this.applications.filter(app => {
        // City filter
        if (this.currentFilterCity !== 'all') {
          if (this.currentFilterCity === 'Diğer') {
            const majorCities = ['İstanbul', 'Samsun', 'Ankara', 'İzmir', 'Bursa', 'Antalya'];
            if (majorCities.includes(app.city)) return false;
          } else if (!app.city.toLowerCase().includes(this.currentFilterCity.toLowerCase())) {
            return false;
          }
        }

        // Status filter
        if (this.currentFilterStatus !== 'all' && app.status !== this.currentFilterStatus) {
          return false;
        }

        // Search
        if (this.currentSearch) {
          const matchName = app.name.toLowerCase().includes(this.currentSearch);
          const matchPhone = app.phone.toLowerCase().includes(this.currentSearch);
          const matchCity = app.city.toLowerCase().includes(this.currentSearch);
          const matchDistrict = (app.district || '').toLowerCase().includes(this.currentSearch);
          const matchCode = app.code.toLowerCase().includes(this.currentSearch);
          if (!matchName && !matchPhone && !matchCity && !matchDistrict && !matchCode) {
            return false;
          }
        }

        return true;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = '';
        emptyState?.classList.remove('hidden');
        return;
      }

      emptyState?.classList.add('hidden');

      tbody.innerHTML = filtered.map(app => {
        const dateObj = new Date(app.date);
        const formattedDate = dateObj.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' });
        const formattedTime = dateObj.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });

        const budgetLabel = app.budget === '4m-plus' ? '₺4M+ (Yüksek)' : app.budget === '2.5m-4m' ? '₺2.5M - ₺4M' : '₺1.5M - ₺2.5M';
        const expLabel = app.experience === 'var' ? '✅ Restoran Deneyimi Var' : app.experience === 'diger' ? '💼 Farklı Sektör İşletmecisi' : '🌱 İlk Girişim';

        const statusClasses: Record<string, string> = {
          'Yeni': 'bg-amber-500/20 text-amber-300 border border-amber-500/30',
          'Görüşme Planlandı': 'bg-blue-500/20 text-blue-300 border border-blue-500/30',
          'Değerlendirmede': 'bg-purple-500/20 text-purple-300 border border-purple-500/30',
          'Onaylandı': 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30',
          'Reddedildi': 'bg-rose-500/20 text-rose-300 border border-rose-500/30',
        };

        return `
          <tr class="hover:bg-white/[0.02] transition-colors">
            
            <!-- Code & Date -->
            <td class="py-4 px-4 sm:px-6">
              <span class="font-mono font-bold text-amber-400 block">${app.code}</span>
              <span class="text-[10px] text-stone-500 font-mono">${formattedDate}, ${formattedTime}</span>
            </td>

            <!-- Investor Name & Contact -->
            <td class="py-4 px-4">
              <span class="font-bold text-white block text-sm">${app.name}</span>
              <div class="flex items-center gap-2 mt-0.5">
                <a href="tel:${app.phone}" class="text-stone-400 hover:text-amber-400 font-mono text-[11px] underline">
                  ${app.phone}
                </a>
                <span class="text-stone-600">•</span>
                <a href="mailto:${app.email}" class="text-stone-400 hover:text-stone-200 text-[11px] underline truncate max-w-[140px]">
                  ${app.email}
                </a>
              </div>
            </td>

            <!-- Target Location -->
            <td class="py-4 px-4">
              <span class="font-semibold text-stone-200 block">${app.city} / ${app.district || 'Merkez'}</span>
              <span class="text-[10px] text-stone-400 uppercase tracking-wider block">
                Mekan: ${app.locationType === 'cadde' ? 'İşlek Cadde' : app.locationType === 'avm' ? 'AVM / Food Court' : app.locationType === 'kampus' ? 'Üniversite Kampüsü' : 'Sahil / Marina'}
              </span>
            </td>

            <!-- Budget & Experience -->
            <td class="py-4 px-4">
              <span class="font-mono text-xs font-bold text-white block">${budgetLabel}</span>
              <span class="text-[10px] text-stone-400 block">${expLabel}</span>
            </td>

            <!-- Status Dropdown -->
            <td class="py-4 px-4">
              <select
                data-app-id="${app.id}"
                class="status-dropdown px-2.5 py-1.5 rounded-lg text-xs font-bold focus:outline-none cursor-pointer ${statusClasses[app.status] || ''}"
              >
                <option value="Yeni" ${app.status === 'Yeni' ? 'selected' : ''}>🟡 Yeni</option>
                <option value="Görüşme Planlandı" ${app.status === 'Görüşme Planlandı' ? 'selected' : ''}>🔵 Görüşme Planlandı</option>
                <option value="Değerlendirmede" ${app.status === 'Değerlendirmede' ? 'selected' : ''}>🟣 Değerlendirmede</option>
                <option value="Onaylandı" ${app.status === 'Onaylandı' ? 'selected' : ''}>🟢 Onaylandı</option>
                <option value="Reddedildi" ${app.status === 'Reddedildi' ? 'selected' : ''}>🔴 Reddedildi</option>
              </select>
            </td>

            <!-- Actions -->
            <td class="py-4 px-4 text-right">
              <div class="inline-flex items-center gap-1.5">
                <button
                  data-detail-id="${app.id}"
                  class="detail-btn p-2 rounded-lg bg-stone-800 hover:bg-stone-700 text-stone-200 hover:text-white transition-colors cursor-pointer"
                  title="Başvuru Detayını Görüntüle"
                >
                  👁️ Detay
                </button>
                <button
                  data-delete-id="${app.id}"
                  class="delete-btn p-2 rounded-lg bg-rose-950/30 hover:bg-rose-900/50 text-rose-300 transition-colors cursor-pointer"
                  title="Başvuruyu Sil"
                >
                  🗑️
                </button>
              </div>
            </td>

          </tr>
        `;
      }).join('');

      // Attach row event listeners
      document.querySelectorAll('.status-dropdown').forEach(el => {
        el.addEventListener('change', (e) => {
          const select = e.target as HTMLSelectElement;
          const id = select.getAttribute('data-app-id');
          const val = select.value as Application['status'];
          if (id) this.updateAppStatus(id, val);
        });
      });

      document.querySelectorAll('.detail-btn').forEach(el => {
        el.addEventListener('click', (e) => {
          const btn = (e.currentTarget as HTMLElement);
          const id = btn.getAttribute('data-detail-id');
          if (id) this.openDetailModal(id);
        });
      });

      document.querySelectorAll('.delete-btn').forEach(el => {
        el.addEventListener('click', (e) => {
          const btn = (e.currentTarget as HTMLElement);
          const id = btn.getAttribute('data-delete-id');
          if (id && confirm('Bu franchise başvurusunu silmek istediğinize emin misiniz?')) {
            this.deleteApplication(id);
          }
        });
      });
    }

    private updateAppStatus(id: string, newStatus: Application['status']) {
      const app = this.applications.find(a => a.id === id);
      if (app) {
        app.status = newStatus;
        this.saveApplications();
      }
    }

    private deleteApplication(id: string) {
      this.applications = this.applications.filter(a => a.id !== id);
      this.saveApplications();
    }

    private openDetailModal(id: string) {
      const app = this.applications.find(a => a.id === id);
      if (!app) return;
      this.activeAppForModal = app;

      const modal = document.getElementById('detail-modal');
      const codeEl = document.getElementById('modal-app-code');
      const dateEl = document.getElementById('modal-app-date');
      const nameEl = document.getElementById('modal-app-name');
      const phoneEl = document.getElementById('modal-app-phone') as HTMLAnchorElement | null;
      const emailEl = document.getElementById('modal-app-email') as HTMLAnchorElement | null;
      const locEl = document.getElementById('modal-app-location');
      const locTypeEl = document.getElementById('modal-app-location-type');
      const budgetEl = document.getElementById('modal-app-budget');
      const expEl = document.getElementById('modal-app-experience');
      const msgEl = document.getElementById('modal-app-message');
      const statusSelect = document.getElementById('modal-status-select') as HTMLSelectElement | null;
      const quickCall = document.getElementById('modal-quick-call') as HTMLAnchorElement | null;

      if (codeEl) codeEl.textContent = app.code;
      if (dateEl) {
        const d = new Date(app.date);
        dateEl.textContent = `${d.toLocaleDateString('tr-TR')} • ${d.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' })}`;
      }
      if (nameEl) nameEl.textContent = app.name;
      if (phoneEl) {
        phoneEl.textContent = app.phone;
        phoneEl.href = `tel:${app.phone}`;
      }
      if (emailEl) {
        emailEl.textContent = app.email;
        emailEl.href = `mailto:${app.email}`;
      }
      if (locEl) locEl.textContent = `${app.city} / ${app.district || 'Merkez'}`;
      if (locTypeEl) locTypeEl.textContent = `Mekan Türü: ${app.locationType}`;
      if (budgetEl) budgetEl.textContent = app.budget;
      if (expEl) expEl.textContent = app.experience === 'var' ? 'Evet, restoran işletme deneyimi var' : app.experience === 'diger' ? 'Farklı sektör işletmecilik tecrübesi var' : 'İlk defa yeme-içme sektörüne yatırım yapacak';
      if (msgEl) msgEl.textContent = app.message ? `"${app.message}"` : 'Aday herhangi bir ek mesaj bırakmadı.';
      if (statusSelect) statusSelect.value = app.status;
      if (quickCall) quickCall.href = `tel:${app.phone}`;

      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    private closeModal() {
      const modal = document.getElementById('detail-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      this.activeAppForModal = null;
    }

    private exportToCSV() {
      if (this.applications.length === 0) {
        alert('Dışa aktarılacak başvuru bulunmamaktadır.');
        return;
      }

      const headers = ['Takip Kodu', 'Tarih', 'Ad Soyad', 'Telefon', 'E-posta', 'Şehir', 'İlçe', 'Bütçe', 'Lokasyon Türü', 'Deneyim', 'Durum', 'Aday Notu'];
      
      const rows = this.applications.map(app => [
        `"${app.code}"`,
        `"${new Date(app.date).toLocaleString('tr-TR')}"`,
        `"${app.name.replace(/"/g, '""')}"`,
        `"${app.phone}"`,
        `"${app.email}"`,
        `"${app.city}"`,
        `"${app.district || ''}"`,
        `"${app.budget}"`,
        `"${app.locationType}"`,
        `"${app.experience}"`,
        `"${app.status}"`,
        `"${(app.message || '').replace(/"/g, '""')}"`
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `Kutuda_Makarna_Franchise_Basvurulari_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new AdminManager());
  } else {
    new AdminManager();
  }
</script>
