---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Yönetici Paneli | Kutuda Makarna HQ"
  description="Kutuda Makarna Franchise ve Şube Yönetim Portalı."
  canonical="https://kutudamakarna.com/admin"
  activePath="/admin"
>
  <div id="admin-app" class="min-h-screen bg-[#0E1217] text-stone-100 py-10 px-4 sm:px-6 lg:px-8">
    
    <!-- ========================================== -->
    <!-- 01: PIN GİRİŞ EKRANI (GİRİŞ YAPILMAMIŞSA) -->
    <!-- ========================================== -->
    <div id="login-screen" class="max-w-md mx-auto my-16 bg-[#161B22] border border-stone-800 rounded-3xl p-8 shadow-2xl space-y-6">
      <div class="text-center space-y-3">
        <div class="w-16 h-16 rounded-2xl bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] flex items-center justify-center mx-auto text-2xl font-black">
          🔒
        </div>
        <h1 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-sans">
          YÖNETİCİ GİRİŞİ
        </h1>
        <p class="text-xs sm:text-sm text-stone-400">
          Kutuda Makarna Genel Merkez Franchise Yönetim Portalı. Devam etmek için erişim şifrenizi girin.
        </p>
      </div>

      <form id="pin-form" class="space-y-4">
        <div>
          <label for="admin-pin" class="block text-xs font-bold uppercase tracking-wider text-stone-300 mb-1.5">
            Erişim Şifresi / PIN
          </label>
          <input
            type="password"
            id="admin-pin"
            placeholder="Şifreyi giriniz (Varsayılan: km2026)"
            required
            autocomplete="current-password"
            class="w-full px-4 py-3.5 rounded-xl bg-[#0E1217] border border-stone-700 text-white text-sm font-mono placeholder:text-stone-600 focus:outline-none focus:border-[#FFB800] focus:ring-1 focus:ring-[#FFB800]"
          />
          <p id="login-error" class="hidden text-xs text-rose-400 mt-2 font-medium">
            ❌ Hatalı şifre girdiniz. Lütfen tekrar deneyin.
          </p>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-xl bg-[#FFB800] hover:bg-[#F59E0B] text-[#1C1917] font-black text-xs uppercase tracking-widest shadow-lg shadow-amber-500/10 transition-all hover:scale-102 active:scale-98 cursor-pointer"
        >
          Panele Giriş Yap →
        </button>
      </form>

      <div class="p-3.5 bg-amber-500/10 border border-amber-500/20 rounded-xl text-center">
        <span class="text-[11px] font-mono text-amber-300 font-semibold">
          💡 Demo Erişim PIN: <span class="bg-black/40 px-2 py-0.5 rounded text-amber-200 font-bold">km2026</span>
        </span>
      </div>

      <div class="text-center pt-2">
        <a href="/" class="text-xs text-stone-500 hover:text-stone-300 transition-colors">
          ← Web Sitesine Geri Dön
        </a>
      </div>
    </div>


    <!-- ========================================== -->
    <!-- 02: YÖNETİM PANELİ DASHBOARD (GİRİŞ YAPILDIĞINDA) -->
    <!-- ========================================== -->
    <div id="dashboard-screen" class="hidden max-w-7xl mx-auto space-y-8">
      
      <!-- Top Bar / Nav -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 border-b border-stone-800">
        <div>
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 rounded-md bg-[#FFB800] text-[#1C1917] text-[10px] font-black uppercase tracking-wider">
              HQ PORTAL
            </span>
            <span class="text-xs text-stone-400 font-mono" id="live-time-display">
              Canlı Sistem
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight mt-1 uppercase">
            FRANCHISE BAŞVURU YÖNETİMİ
          </h1>
          <p class="text-xs text-stone-400">
            Tüm şehirlerden gelen yatırımcı başvurularını inceleyin, durumlarını güncelleyin ve arşivleyin.
          </p>
        </div>

        <div class="flex items-center flex-wrap gap-2.5">
          <button
            id="simulate-lead-btn"
            title="Müşteri sunumunda yeni bir başvurunun düşüşünü canlı göster"
            class="px-3.5 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/30 text-xs font-bold transition-all flex items-center gap-1.5 cursor-pointer"
          >
            <span>⚡</span>
            <span>+ Canlı Başvuru Simüle Et</span>
          </button>

          <button
            id="export-csv-btn"
            class="px-4 py-2.5 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
          >
            <span>📥</span>
            <span>Excel / CSV İndir</span>
          </button>
          
          <button
            id="reset-mock-btn"
            title="Demo başvuru verilerini sıfırla/tazele"
            class="px-3.5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-semibold transition-all cursor-pointer"
          >
            🔄 Verileri Tazele
          </button>

          <a
            href="/"
            class="px-3.5 py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-stone-300 text-xs font-semibold transition-all"
          >
            🌐 Siteyi Aç
          </a>

          <button
            id="logout-btn"
            class="px-3.5 py-2.5 rounded-xl bg-rose-950/40 hover:bg-rose-900/60 text-rose-300 border border-rose-800/40 text-xs font-bold transition-all cursor-pointer"
          >
            Çıkış ✕
          </button>
        </div>
      </div>

      <!-- KPI Metric Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Total Applications -->
        <div class="p-5 rounded-2xl bg-[#161B22] border border-stone-800 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-stone-400">Toplam Başvuru</span>
          <div class="flex items-baseline justify-between">
            <span id="metric-total" class="text-3xl sm:text-4xl font-black text-white font-mono">0</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-800 text-stone-300">Portföy</span>
          </div>
          <span class="text-[11px] text-stone-500 block">Sistemde kayıtlı toplam aday</span>
        </div>

        <!-- Pending / New -->
        <div class="p-5 rounded-2xl bg-[#161B22] border border-stone-800 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            Yeni & Bekleyen
          </span>
          <div class="flex items-baseline justify-between">
            <span id="metric-new" class="text-3xl sm:text-4xl font-black text-amber-400 font-mono">0</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400">Öncelikli</span>
          </div>
          <span class="text-[11px] text-stone-500 block">48 saat içinde aranacaklar</span>
        </div>

        <!-- In Review / Approved -->
        <div class="p-5 rounded-2xl bg-[#161B22] border border-stone-800 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Görüşülen / Onaylanan</span>
          <div class="flex items-baseline justify-between">
            <span id="metric-progress" class="text-3xl sm:text-4xl font-black text-emerald-400 font-mono">0</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400">Aktif Süreç</span>
          </div>
          <span class="text-[11px] text-stone-500 block">Müzakere veya onay aşamasında</span>
        </div>

        <!-- Total Capital Pipeline -->
        <div class="p-5 rounded-2xl bg-[#161B22] border border-stone-800 space-y-1">
          <span class="text-xs font-bold uppercase tracking-wider text-blue-400">Yatırım Havuzu</span>
          <div class="flex items-baseline justify-between">
            <span id="metric-capital" class="text-2xl sm:text-3xl font-black text-white font-mono">₺0M</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400">Tahmini</span>
          </div>
          <span class="text-[11px] text-stone-500 block">Adayların beyan ettiği sermaye</span>
        </div>

      </div>

      <!-- Controls: Search & Filters -->
      <div class="p-4 rounded-2xl bg-[#161B22] border border-stone-800 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        
        <!-- Search Input -->
        <div class="relative flex-1">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-500 text-sm">🔍</span>
          <input
            type="text"
            id="search-input"
            placeholder="İsim, telefon, şehir veya takip kodu ara..."
            class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#0E1217] border border-stone-700 text-white text-xs sm:text-sm placeholder:text-stone-500 focus:outline-none focus:border-[#FFB800]"
          />
        </div>

        <!-- Filters -->
        <div class="flex items-center gap-2.5">
          <select
            id="filter-city"
            class="px-3 py-2.5 rounded-xl bg-[#0E1217] border border-stone-700 text-white text-xs font-semibold focus:outline-none focus:border-[#FFB800]"
          >
            <option value="all">Tüm Şehirler</option>
            <option value="İstanbul">İstanbul</option>
            <option value="Samsun">Samsun</option>
            <option value="Ankara">Ankara</option>
            <option value="İzmir">İzmir</option>
            <option value="Bursa">Bursa</option>
            <option value="Antalya">Antalya</option>
            <option value="Diğer">Diğer Şehirler</option>
          </select>

          <select
            id="filter-status"
            class="px-3 py-2.5 rounded-xl bg-[#0E1217] border border-stone-700 text-white text-xs font-semibold focus:outline-none focus:border-[#FFB800]"
          >
            <option value="all">Tüm Durumlar</option>
            <option value="Yeni">Yeni</option>
            <option value="Görüşme Planlandı">Görüşme Planlandı</option>
            <option value="Değerlendirmede">Değerlendirmede</option>
            <option value="Onaylandı">Onaylandı</option>
            <option value="Reddedildi">Reddedildi</option>
          </select>
        </div>

      </div>

      <!-- Applications Table -->
      <div class="bg-[#161B22] border border-stone-800 rounded-3xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-stone-300">
            <thead class="bg-[#1F242C] text-stone-400 font-bold uppercase tracking-wider text-[10px] border-b border-stone-800">
              <tr>
                <th scope="col" class="py-4 px-4 sm:px-6">Kod & Tarih</th>
                <th scope="col" class="py-4 px-4">Yatırımcı Adayı</th>
                <th scope="col" class="py-4 px-4">Hedef Lokasyon</th>
                <th scope="col" class="py-4 px-4">Bütçe & Tecrübe</th>
                <th scope="col" class="py-4 px-4">Başvuru Durumu</th>
                <th scope="col" class="py-4 px-4 text-right">İşlemler</th>
              </tr>
            </thead>
            <tbody id="applications-table-body" class="divide-y divide-stone-800 font-normal">
              <!-- Dynamically populated via JS -->
            </tbody>
          </table>
        </div>

        <!-- Empty state placeholder -->
        <div id="table-empty-state" class="hidden py-16 text-center space-y-3">
          <div class="text-4xl">📂</div>
          <h3 class="text-base font-bold text-white">Kayıt Bulunamadı</h3>
          <p class="text-xs text-stone-400 max-w-sm mx-auto">
            Arama kriterlerinize uygun başvuru bulunmamaktadır. Filtreleri temizleyebilir veya yeni başvuru ekleyebilirsiniz.
          </p>
        </div>
      </div>

      <!-- Bottom Reference Section: Active Branches Snapshot -->
      <div class="p-6 rounded-3xl bg-[#161B22] border border-stone-800 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-sm font-black uppercase text-white tracking-wide">
              Mevcut Şube Ağı (8 Aktif Şube)
            </h3>
            <p class="text-xs text-stone-400">
              Franchise adaylarına sunulan mevcut bölgesel operasyon ağı.
            </p>
          </div>
          <span class="text-xs font-mono font-bold text-amber-400">8 Şube / 6 Şehir</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">Samsun Atakum</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Merkez Şube)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">Samsun İlkadım</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Cadde)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">Samsun Tekkeköy</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (AVM & Sanayi)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">İstanbul Kadıköy</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Moda / Rıhtım)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">İstanbul Beşiktaş</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Çarşı / Kampüs)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">Ankara Çankaya</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Tunalı / Kızılay)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">İzmir Karşıyaka</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (Çarşı / Sahil)</span>
          </div>
          <div class="p-3 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-white font-bold block">Bursa Nilüfer</span>
            <span class="text-[10px] text-emerald-400 font-mono">● Açık (FSM Bulvarı)</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- 03: BAŞVURU DETAY MODAL -->
    <!-- ========================================== -->
    <div id="detail-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-[#161B22] border border-stone-700 w-full max-w-2xl rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        
        <button
          id="close-modal-btn"
          class="absolute top-6 right-6 w-9 h-9 rounded-full bg-stone-800 text-stone-400 hover:text-white flex items-center justify-center text-sm font-black transition-colors cursor-pointer"
        >
          ✕
        </button>

        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span id="modal-app-code" class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-500/20 text-[#FFB800]">#FR-KM-2026-XXXX</span>
            <span id="modal-app-date" class="text-xs text-stone-400 font-mono">Tarih</span>
          </div>
          <h2 id="modal-app-name" class="text-2xl font-black text-white">Yatırımcı Adı</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-stone-400 uppercase tracking-wider font-bold text-[10px]">İletişim</span>
            <div class="space-y-1 pt-1">
              <div>📞 <a id="modal-app-phone" href="#" class="text-amber-400 hover:underline font-mono">Telefon</a></div>
              <div>✉️ <a id="modal-app-email" href="#" class="text-stone-200 hover:underline font-mono">E-posta</a></div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-stone-400 uppercase tracking-wider font-bold text-[10px]">Hedef Lokasyon</span>
            <div class="space-y-1 pt-1">
              <div class="text-white font-bold" id="modal-app-location">Şehir / İlçe</div>
              <div class="text-stone-400" id="modal-app-location-type">Mekan Tipi: Cadde</div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-stone-400 uppercase tracking-wider font-bold text-[10px]">Yatırım Bütçesi</span>
            <div class="text-white font-bold text-sm pt-1" id="modal-app-budget">2.500.000 TL - 4.000.000 TL</div>
          </div>

          <div class="p-4 rounded-xl bg-[#0E1217] border border-stone-800 space-y-1">
            <span class="text-stone-400 uppercase tracking-wider font-bold text-[10px]">Yeme-İçme Tecrübesi</span>
            <div class="text-white font-bold pt-1" id="modal-app-experience">Daha önce restoran işletti</div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-[#0E1217] border border-stone-800 space-y-2 text-xs">
          <span class="text-stone-400 uppercase tracking-wider font-bold text-[10px] block">Adayın Notu & Mesajı</span>
          <p id="modal-app-message" class="text-stone-300 leading-relaxed font-light italic">
            Mesaj bulunmuyor.
          </p>
        </div>

        <!-- Quick Status Update in Modal -->
        <div class="flex items-center justify-between pt-4 border-t border-stone-800">
          <div class="flex items-center gap-2">
            <span class="text-xs text-stone-400 font-bold">Durum Değiştir:</span>
            <select
              id="modal-status-select"
              class="px-3 py-1.5 rounded-lg bg-[#0E1217] border border-stone-700 text-white text-xs font-semibold focus:outline-none focus:border-[#FFB800]"
            >
              <option value="Yeni">Yeni</option>
              <option value="Görüşme Planlandı">Görüşme Planlandı</option>
              <option value="Değerlendirmede">Değerlendirmede</option>
              <option value="Onaylandı">Onaylandı</option>
              <option value="Reddedildi">Reddedildi</option>
            </select>
          </div>

          <div class="flex items-center gap-2">
            <a
              id="modal-quick-call"
              href="#"
              class="px-4 py-2 rounded-xl bg-[#FFB800] text-[#1C1917] font-bold text-xs hover:bg-[#F59E0B] transition-colors"
            >
              Hemen Ara
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</Layout>

<script>
  interface Application {
    id: string;
    code: string;
    date: string;
    name: string;
    phone: string;
    email: string;
    city: string;
    district: string;
    budget: string;
    locationType: string;
    experience: string;
    message: string;
    status: 'Yeni' | 'Görüşme Planlandı' | 'Değerlendirmede' | 'Onaylandı' | 'Reddedildi';
  }

  const DEFAULT_APPLICATIONS: Application[] = [
    {
