---
import Layout from '../../layouts/Layout.astro';
import { articles, type Article } from '../../data/articles';
import { menuItems } from '../../data/menu';
import { branches } from '../../data/branches';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;

// Associated products for internal linking
const relatedProducts = menuItems.filter(item => article.relatedProducts.includes(item.slug));

// Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  'headline': article.title,
  'description': article.metaDescription,
  'author': {
    '@type': 'Organization',
    'name': article.author
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Kutuda Makarna',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://kutudamakarna.com/images/logo.png'
    }
  },
  'datePublished': article.date,
  'mainEntityOfPage': `https://kutudamakarna.com/makarna/${article.slug}`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Ana Sayfa',
      'item': 'https://kutudamakarna.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Makarna Rehberi',
      'item': 'https://kutudamakarna.com/makarna'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': article.title,
      'item': `https://kutudamakarna.com/makarna/${article.slug}`
    }
  ]
};
---

<Layout
  title={article.metaTitle}
  description={article.metaDescription}
  canonical={`https://kutudamakarna.com/makarna/${article.slug}`}
  activePath="/makarna"
  ogType="article"
  schemaJson={[articleSchema, breadcrumbSchema]}
>
  <article class="py-10 lg:py-16 bg-[#0E0E10]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 text-xs font-semibold text-zinc-400">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-[#FFB800] transition-colors">Ana Sayfa</a></li>
          <li><span>/</span></li>
          <li><a href="/makarna" class="hover:text-[#FFB800] transition-colors">Makarna Rehberi</a></li>
          <li><span>/</span></li>
          <li class="text-[#FFB800] truncate max-w-sm">{article.title}</li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="space-y-4 pb-8 border-b border-zinc-800">
        <div class="flex items-center gap-3 text-xs">
          <span class="px-3 py-1 rounded-full bg-[#FFB800]/15 text-[#FFB800] font-bold uppercase tracking-wider">
            {article.category}
          </span>
          <span class="text-zinc-500">•</span>
          <span class="text-zinc-400">{article.readTime}</span>
          <span class="text-zinc-500">•</span>
          <span class="text-zinc-400">{article.date}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-sans leading-tight">
          {article.title}
        </h1>

        <p class="text-lg text-zinc-300 leading-relaxed font-normal">
          {article.excerpt}
        </p>

        <div class="flex items-center gap-3 pt-2 text-xs text-zinc-400">
          <div class="w-8 h-8 rounded-full bg-[#FFB800] text-[#0E0E10] font-black flex items-center justify-center text-xs">
            KM
          </div>
          <div>
            <span class="font-bold text-white block">{article.author}</span>
            <span class="text-[11px] text-zinc-500">Kutuda Makarna Araştırma & Şef Ekibi</span>
          </div>
        </div>
      </header>

      <!-- Main Prose Content -->
      <div class="py-10 prose prose-invert max-w-none space-y-6 text-zinc-300 leading-relaxed text-base [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-white [&_h2]:pt-6 [&_h2]:border-l-2 [&_h2]:border-[#FFB800] [&_h2]:pl-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:space-y-2 [&_li]:text-zinc-300 [&_strong]:text-[#FFB800]">
        <Fragment set:html={article.content} />
      </div>

      <!-- Contextual Internal Linking: Related Menu Items -->
      {relatedProducts.length > 0 && (
        <div class="my-12 p-8 rounded-3xl bg-[#14141A] border border-[rgba(255,184,0,0.25)] space-y-6">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🍝</span>
            <div>
              <h3 class="text-lg font-bold text-white">Bu Rehberdeki Lezzetleri Sıcak Kutuda Deneyin</h3>
              <p class="text-xs text-zinc-400">Kutuda Makarna şubelerimizde tam bu kurallarla taze hazırlanıyor.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedProducts.map((p) => (
              <a
                href={`/menu/${p.slug}`}
                class="p-4 rounded-xl bg-zinc-900/80 border border-zinc-800 hover:border-[#FFB800] transition-colors group block"
              >
                <span class="text-xs font-bold text-[#FFB800] block mb-1">{p.name}</span>
                <span class="text-[11px] text-zinc-400 block line-clamp-1">{p.shortDescription}</span>
                <span class="text-xs font-bold text-white mt-2 block">{p.price} ₺ →</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tags & Share -->
      <footer class="pt-8 border-t border-zinc-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2">
          {article.tags.map((t) => (
            <span class="px-3 py-1 rounded-full text-xs bg-zinc-900 text-zinc-300 border border-zinc-800">
              #{t}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-3">
          <a
            href="/menu"
            class="px-5 py-2.5 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-xs hover:bg-[#F59E0B] transition-transform hover:scale-105"
          >
            Menüye Git →
          </a>
        </div>
      </footer>

    </div>
  </article>
</Layout>
