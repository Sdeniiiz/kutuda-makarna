---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': 'Kutuda Makarna Gastronomi Rehberi',
  'description': 'Makarna pişirme sırları, al dente felsefesi, sos eşleşmeleri ve İtalyan makarna kültürü rehberi.',
  'url': 'https://kutudamakarna.com/makarna'
};
---

<Layout
  title="Makarna Rehberi & Gastronomi Kültürü | Kutuda Makarna"
  description="Makarna nasıl pişirilir? Al dente nedir, makarna çeşitleri ve sos eşleşmeleri nasıl yapılır? İtalyan mutfağının sırları Kutuda Makarna rehberinde."
  canonical="https://kutudamakarna.com/makarna"
  activePath="/makarna"
  schemaJson={hubSchema}
>
  <div class="py-12 lg:py-20 bg-gradient-to-b from-[#0E0E10] to-[#121216]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-bold uppercase tracking-wider mb-4">
          <span>📚 Gastronomi Kütüphanesi</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight font-sans">
          MAKARNA KÜLTÜRÜ & <span class="text-[#FFB800]">REHBERLER</span>
        </h1>
        <p class="text-zinc-400 mt-3 text-base sm:text-lg">
          Gerçek bir makarna tutkunu olmak için bilmeniz gereken tüm lezzet sırları, pişirme teknikleri ve eşleşme kuralları.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-[#14141A] border border-zinc-800 rounded-3xl p-8 flex flex-col justify-between card-hover group">
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs text-zinc-500">
                <span class="text-[#FFB800] font-bold uppercase tracking-wider">{art.category}</span>
                <span>{art.readTime}</span>
              </div>
              
              <h2 class="text-2xl font-bold text-white group-hover:text-[#FFB800] transition-colors leading-snug">
                <a href={`/makarna/${art.slug}`}>{art.title}</a>
              </h2>

              <p class="text-xs text-zinc-400 leading-relaxed">
                {art.excerpt}
              </p>

              <div class="flex flex-wrap gap-1.5 pt-2">
                {art.tags.map((t) => (
                  <span class="px-2 py-0.5 rounded text-[10px] bg-zinc-900 text-zinc-400 border border-zinc-800">
                    #{t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-8 mt-8 border-t border-zinc-800 flex items-center justify-between">
              <span class="text-[11px] text-zinc-500">{art.author}</span>
              <a
                href={`/makarna/${art.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#FFB800] group-hover:underline"
              >
                <span>Rehberi Oku</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Content CTA Banner -->
      <div class="mt-16 bg-[#16161C] border border-zinc-800 rounded-2xl p-8 sm:p-10 text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl font-bold text-white">Okurken Acıktın mı?</h3>
        <p class="text-zinc-400 text-sm">
          Al dente kıvamında açılan taze makarnalarımız tavadaki taze soslarla kutunda seni bekliyor.
        </p>
        <div class="pt-2">
          <a
            href="/menu"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-sm hover:bg-[#F59E0B] shadow-lg shadow-[#FFB800]/25 transition-transform hover:scale-105"
          >
            <span>Hemen Menüyü İncele</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
