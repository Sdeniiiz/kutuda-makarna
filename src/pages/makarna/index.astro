---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

const hubSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': 'Kutuda Makarna Gastronomi Rehberi',
  'description': 'Makarna pişirme sırları, al dente felsefesi, sos eşleşmeleri ve İtalyan makarna kültürü rehberi.',
  'url': 'https://kutudamakarna.com/makarna'
};
---

<Layout
  title="Makarna Rehberi & Gastronomi Kültürü | Kutuda Makarna"
  description="Makarna nasıl pişirilir? Al dente nedir, makarna çeşitleri ve sos eşleşmeleri nasıl yapılır? İtalyan mutfağının sırları Kutuda Makarna rehberinde."
  canonical="https://kutudamakarna.com/makarna"
  activePath="/makarna"
  schemaJson={hubSchema}
>
  <div class="py-12 lg:py-20 bg-[#FBF9F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[#B45309] text-xs font-black uppercase tracking-wider mb-4">
          <span>📚 Gastronomi Kütüphanesi</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-black text-[#1C1917] tracking-tight font-sans">
          MAKARNA KÜLTÜRÜ & <span class="text-[#D97706]">REHBERLER</span>
        </h1>
        <p class="text-stone-600 mt-3 text-base sm:text-lg">
          Gerçek bir makarna tutkunu olmak için bilmeniz gereken tüm lezzet sırları, pişirme teknikleri ve eşleşme kuralları.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-white border border-stone-200/90 rounded-3xl p-8 flex flex-col justify-between hover:shadow-xl hover:shadow-amber-950/5 hover:-translate-y-1 transition-all duration-300 group shadow-xs">
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs text-stone-500">
                <span class="text-[#B45309] font-black uppercase tracking-wider bg-amber-100/70 px-2.5 py-0.5 rounded-full">{art.category}</span>
                <span class="font-medium">⏱️ {art.readTime}</span>
              </div>
              
              <h2 class="text-2xl font-black text-[#1C1917] group-hover:text-[#D97706] transition-colors leading-snug">
                <a href={`/makarna/${art.slug}`}>{art.title}</a>
              </h2>

              <p class="text-xs text-stone-600 leading-relaxed">
                {art.excerpt}
              </p>

              <div class="flex flex-wrap gap-1.5 pt-2">
                {art.tags.map((t) => (
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] bg-stone-100 text-stone-600 border border-stone-200 font-medium">
                    #{t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-8 mt-8 border-t border-stone-100 flex items-center justify-between">
              <span class="text-[11px] text-stone-500 font-medium">{art.author}</span>
              <a
                href={`/makarna/${art.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#D97706] group-hover:underline"
              >
                <span>Rehberi Oku</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Content CTA Banner -->
      <div class="mt-16 bg-white border border-stone-200/90 rounded-3xl p-8 sm:p-10 text-center max-w-3xl mx-auto space-y-4 shadow-sm">
        <h3 class="text-2xl font-black text-[#1C1917]">Okurken Acıktın mı?</h3>
        <p class="text-stone-600 text-sm">
          Al dente kıvamında açılan taze makarnalarımız tavadaki taze soslarla kutunda seni bekliyor.
        </p>
        <div class="pt-2">
          <a
            href="/menu"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-[#FFB800] text-[#1C1917] font-black text-sm hover:bg-[#F59E0B] shadow-md shadow-amber-500/20 transition-transform hover:scale-105"
          >
            <span>Hemen Menüyü İncele</span>
            <span>→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
