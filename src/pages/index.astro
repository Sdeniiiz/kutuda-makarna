---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BoxScrollAnimation from '../components/BoxScrollAnimation.astro';
import ProductCard from '../components/ProductCard.astro';
import WhyBox from '../components/WhyBox.astro';
import StoreFrontFeature from '../components/StoreFrontFeature.astro';
import BranchesSection from '../components/BranchesSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { menuItems } from '../data/menu';
import { articles } from '../data/articles';

// Top 4 featured pastas
const featuredItems = menuItems.filter(item => item.isPopular).slice(0, 4);

// FAQ Schema for Structured Data
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Makarnalarınız taze mi yoksa paket kuru makarna mı kullanıyorsunuz?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Kutuda Makarna olarak yalnızca %100 durum buğdayı irmiği ile günlük el yapımı taze makarna kullanıyoruz. Fabrikasyon kuru paket makarna kullanmıyoruz.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Kutuda makarna ne kadar süre sıcak kalır?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Çift katmanlı gıdaya uygun termo-kutu teknolojimiz sayesinde makarnanız 30 dakika boyunca ideal servis sıcaklığını ve buharını muhafaza eder.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Siparişim ne kadar sürede hazırlanır?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Taze makarna haşlama kazanlarımız ve tavadaki hızlı sos bağlama sürecimiz sayesinde siparişiniz ortalama 3 ile 4 dakika içinde sıcacık kutusunda teslim edilir.'
      }
    }
  ]
};
---

<Layout
  title="Kutuda Makarna | Taze Makarna & Özel Soslar | Samsun"
  description="Kutuda Makarna: Taze makarna, bol sos ve kutuya sığmayan lezzet! Samsun Atakum, İlkadım ve Tekkeköy şubelerimizde 3 dakikada hazırlanan sıcacık al dente makarnalar."
  canonical="https://kutudamakarna.com/"
  activePath="/"
  schemaJson={faqSchema}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Marquee / Value Strip -->
  <div class="bg-[#FFB800] py-3 text-[#0E0E10] font-black text-xs sm:text-sm tracking-wider uppercase overflow-hidden border-y border-[#D97706]">
    <div class="flex items-center justify-around gap-8 whitespace-nowrap animate-none">
      <span>🍝 %100 Taze Durum Hamuru</span>
      <span class="hidden sm:inline">•</span>
      <span>⏱️ 3 Dakikada Tavadan Kutuya</span>
      <span class="hidden sm:inline">•</span>
      <span>🔥 Al Dente Kıvam Garantisi</span>
      <span class="hidden sm:inline">•</span>
      <span>📍 Samsun (Atakum • İlkadım • Tekkeköy)</span>
    </div>
  </div>

  <!-- Signature GSAP ScrollTrigger Box Animation -->
  <BoxScrollAnimation />

  <!-- Featured Menu Section -->
  <section class="py-20 lg:py-24 bg-[#0E0E10]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-bold uppercase tracking-wider mb-3">
            <span>⭐ İmza Lezzetler</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight font-sans">
            EN ÇOK SEVİLEN <span class="text-[#FFB800]">KUTU MAKARNALAR</span>
          </h2>
          <p class="text-zinc-400 mt-2 text-sm sm:text-base max-w-xl">
            Taze kültür mantarlarından 4 saat demlenen bolonez sosuna kadar; en çok tercih edilen kutu çeşitlerimiz.
          </p>
        </div>

        <a
          href="/menu"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-zinc-900 border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-sm transition-all hover:bg-zinc-800"
        >
          <span>Tüm Menüyü İncele</span>
          <span>→</span>
        </a>
      </div>

      <!-- Grid of Featured Products -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredItems.map((item) => (
          <ProductCard item={item} />
        ))}
      </div>
    </div>
  </section>

  <!-- Why the Box? Section -->
  <WhyBox />

  <!-- Storefront Architecture & Kiosk Feature -->
  <StoreFrontFeature />

  <!-- Local SEO Branches Section -->
  <BranchesSection />

  <!-- Informational Topic Authority (Blog/Rehber Önizleme) -->
  <section class="py-20 bg-[#121216] border-t border-zinc-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-bold uppercase tracking-wider mb-3">
            <span>📚 Makarna Kültürü</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight font-sans">
            GASTRONOMİ <span class="text-[#FFB800]">REHBERİ</span>
          </h2>
          <p class="text-zinc-400 mt-2 text-sm sm:text-base">
            Al dente pişirme sırları, sos eşleşmeleri ve İtalyan makarna teknikleri.
          </p>
        </div>

        <a href="/makarna" class="text-[#FFB800] hover:text-[#F59E0B] font-bold text-sm inline-flex items-center gap-2">
          <span>Tüm Rehberleri Oku</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="bg-[#17171E] border border-zinc-800 rounded-2xl p-6 flex flex-col justify-between card-hover group">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs text-zinc-500">
                <span class="text-[#FFB800] font-semibold">{art.category}</span>
                <span>{art.readTime}</span>
              </div>
              <h3 class="text-xl font-bold text-white group-hover:text-[#FFB800] transition-colors">
                <a href={`/makarna/${art.slug}`}>{art.title}</a>
              </h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                {art.excerpt}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-zinc-800/80">
              <a
                href={`/makarna/${art.slug}`}
                class="text-xs font-bold text-[#FFB800] group-hover:underline inline-flex items-center gap-1.5"
              >
                <span>Yazıyı Oku</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Real User FAQ Section -->
  <FaqSection />

  <!-- Final Call to Action -->
  <section class="py-20 bg-gradient-to-t from-[#0A0A0C] via-[#121216] to-[#0E0E10] border-t border-zinc-900 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      <div class="w-16 h-16 rounded-2xl bg-[#FFB800] text-[#0E0E10] font-black text-3xl mx-auto flex items-center justify-center shadow-xl shadow-[#FFB800]/20">
        📦
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-sans">
        KUTUNU SEÇMEYE <span class="text-[#FFB800]">HAZIR MISIN?</span>
      </h2>
      <p class="text-zinc-300 text-base sm:text-lg max-w-xl mx-auto">
        Taze makarna hamuru ve sıcacık soslar seni bekliyor. Menüyü hemen keşfet veya en yakın şubemize uğra!
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/menu"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-base hover:bg-[#F59E0B] shadow-xl shadow-[#FFB800]/25 transition-all hover:scale-105"
        >
          MENÜYÜ GÖR & KUTUNU SEÇ
        </a>
        <a
          href="/subeler"
          class="w-full sm:w-auto px-8 py-4 rounded-xl border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-base transition-all hover:bg-zinc-800"
        >
          EN YAKIN ŞUBE NEREDE?
        </a>
      </div>
    </div>
  </section>
</Layout>
