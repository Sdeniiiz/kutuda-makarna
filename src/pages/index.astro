---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BoxScrollAnimation from '../components/BoxScrollAnimation.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import FinalCTA from '../components/FinalCTA.astro';

// Structured data for homepage
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Kutuda Makarna',
  'alternateName': 'Kutuda Makarna Türkiye',
  'url': 'https://kutudamakarna.com',
  'logo': 'https://kutudamakarna.com/images/logo.png',
  'slogan': 'Lezzet Kutuda Saklı!',
  'sameAs': [
    'https://www.instagram.com/kutudamakarna'
  ],
  'contactPoint': {
    '@type': 'ContactPoint',
    'telephone': '+90-362-500-0101',
    'contactType': 'customer service',
    'areaServed': 'TR',
    'availableLanguage': 'Turkish'
  }
};
---

<Layout
  title="Kutuda Makarna | Taze Makarna & Özel Soslar"
  description="Kutuda Makarna: Taze makarna, bol sos ve kutuda yepyeni bir lezzet deneyimi! Al dente makarnayı kutuda keşfet."
  canonical="https://kutudamakarna.com/"
  activePath="/"
  schemaJson={organizationSchema}
>
  <!-- 01: HERO (Fullscreen feel, punchy typography, large box, subtle parallax) -->
  <Hero />

  <!-- 02: THE BOX EXPERIENCE (Scroll-driven GSAP pinned pasta filling animation) -->
  <BoxScrollAnimation />

  <!-- 03: PRODUCT SHOWCASE ("ŞİMDİ ZOR KISIM", photo-first minimal dark luxury) -->
  <ProductShowcase />

  <!-- 04: FINAL CTA ("ACIKTIYSAN KUTUYU BUL", opening box animation & triple action) -->
  <FinalCTA />
</Layout>
