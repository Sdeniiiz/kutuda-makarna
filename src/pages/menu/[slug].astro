---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { menuItems, getRelatedMenuItems, type MenuItem } from '../../data/menu';
import { branches } from '../../data/branches';

export function getStaticPaths() {
  return menuItems.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
const relatedItems = getRelatedMenuItems(item.slug, 3);

// JSON-LD Product & MenuItem Schema
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  'name': item.name,
  'image': `https://kutudamakarna.com${item.image}`,
  'description': item.description,
  'brand': {
    '@type': 'Brand',
    'name': 'Kutuda Makarna'
  },
  'offers': {
    '@type': 'Offer',
    'url': `https://kutudamakarna.com/menu/${item.slug}`,
    'priceCurrency': 'TRY',
    'price': item.price,
    'priceValidUntil': '2026-12-31',
    'itemCondition': 'https://schema.org/NewCondition',
    'availability': 'https://schema.org/InStock',
    'seller': {
      '@type': 'Organization',
      'name': 'Kutuda Makarna'
    }
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Ana Sayfa',
      'item': 'https://kutudamakarna.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Menü',
      'item': 'https://kutudamakarna.com/menu'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': item.name,
      'item': `https://kutudamakarna.com/menu/${item.slug}`
    }
  ]
};
---

<Layout
  title={`${item.name} | Kutuda Makarna Fiyat & İçerik`}
  description={`${item.name}: ${item.shortDescription} Taze durum hamuru, özel sıcak kutusunda al dente lezzet.`}
  canonical={`https://kutudamakarna.com/menu/${item.slug}`}
  activePath="/menu"
  schemaJson={[productSchema, breadcrumbSchema]}
>
  <div class="py-10 lg:py-16 bg-[#FBF9F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8 text-xs font-semibold text-stone-500">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-[#D97706] transition-colors">Ana Sayfa</a></li>
          <li><span class="text-stone-300">/</span></li>
          <li><a href="/menu" class="hover:text-[#D97706] transition-colors">Menü</a></li>
          <li><span class="text-stone-300">/</span></li>
          <li class="text-[#D97706] font-bold truncate max-w-xs">{item.name}</li>
        </ol>
      </nav>

      <!-- Main Product Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Product Presentation Box -->
        <div class="lg:col-span-6 space-y-6">
          <div class="relative w-full aspect-square rounded-3xl overflow-hidden border-2 border-stone-200/90 shadow-xl bg-stone-100 group">
            <img
              src={item.image}
              alt={item.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>

            <!-- Rising Steam Lines -->
            <div class="absolute top-6 left-6 flex gap-4 pointer-events-none opacity-80">
              <svg class="w-6 h-12 text-white/80 animate-steam-1" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 55 C 6 45, 18 35, 12 25 C 6 15, 18 5, 12 0" />
              </svg>
              <svg class="w-6 h-12 text-white/90 animate-steam-2" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 55 C 18 45, 6 35, 12 25 C 18 15, 6 5, 12 0" />
              </svg>
            </div>

            <!-- Bottom Thermal Box Badge -->
            <div class="absolute bottom-4 left-6 right-6 bg-white/95 backdrop-blur-md border border-stone-200 rounded-2xl px-4 py-3 flex items-center justify-between text-xs shadow-md">
              <span class="text-stone-700 font-bold flex items-center gap-1.5">
                <span>🌡️ Termo-Kutu:</span>
                <span class="text-[#D97706] font-black">30 Dk İlk Anki Sıcaklık</span>
              </span>
              <span class="text-[10px] font-black uppercase bg-[#1C1917] text-white px-2.5 py-1 rounded-lg">
                {item.pastaType}
              </span>
            </div>
          </div>

          <!-- Pairing Recommendation Callout -->
          <div class="bg-white border border-stone-200/90 rounded-2xl p-5 flex items-center gap-4 shadow-xs">
            <div class="w-12 h-12 rounded-xl bg-amber-100/70 border border-amber-200/70 flex items-center justify-center text-xl shrink-0">
              💡
            </div>
            <div>
              <div class="text-xs font-bold text-[#B45309] uppercase tracking-wider">Şefin Eşleşme Önerisi</div>
              <p class="text-xs text-stone-600 mt-0.5">{item.pairingRecommendation}</p>
            </div>
          </div>
        </div>

        <!-- Right: Specs, Story, Ingredients, Allergens, CTA -->
        <div class="lg:col-span-6 space-y-8">
          
          <!-- Title & Badges -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              {item.badge && (
                <span class="px-3 py-1 rounded-full text-xs font-black bg-amber-100/80 text-[#B45309] border border-amber-200 uppercase tracking-wide">
                  {item.badge}
                </span>
              )}
              {item.isVegetarian && (
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                  Vejetaryen 🌱
                </span>
              )}
              {item.spicyLevel > 0 && (
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">
                  {'🌶️'.repeat(item.spicyLevel)} Acılı
                </span>
              )}
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-[#1C1917] tracking-tight font-sans">
              {item.name}
            </h1>
            <p class="text-stone-600 text-sm sm:text-base mt-3 leading-relaxed">
              {item.shortDescription}
            </p>
          </div>

          <!-- Price & Metrics Bar -->
          <div class="bg-white border border-stone-200/90 rounded-2xl p-5 grid grid-cols-2 sm:grid-cols-4 gap-4 shadow-xs">
            <div>
              <span class="text-xs text-stone-500 block font-medium">Fiyat</span>
              <span class="text-2xl font-black text-[#1C1917]">{item.price} <span class="text-sm text-[#D97706] font-bold">₺</span></span>
            </div>
            <div>
              <span class="text-xs text-stone-500 block font-medium">Porsiyon</span>
              <span class="text-base font-bold text-stone-800">{item.portionGrams} gram</span>
            </div>
            <div>
              <span class="text-xs text-stone-500 block font-medium">Enerji</span>
              <span class="text-base font-bold text-stone-800">{item.calories} kcal</span>
            </div>
            <div>
              <span class="text-xs text-stone-500 block font-medium">Hazırlık</span>
              <span class="text-base font-bold text-emerald-700">⏱️ {item.prepTimeMinutes} dk</span>
            </div>
          </div>

          <!-- Culinary Story -->
          <div class="space-y-3">
            <h2 class="text-lg font-black text-[#1C1917] uppercase tracking-wider border-l-3 border-[#D97706] pl-2.5">
              Lezzet Hikayesi & Sos Karakteri
            </h2>
            <p class="text-sm text-stone-700 leading-relaxed">
              {item.description}
            </p>
            <p class="text-xs text-stone-500 italic">
              <strong>Sos Detayı:</strong> {item.sauceDetails}
            </p>
          </div>

          <!-- Ingredients List -->
          <div class="space-y-3">
            <h3 class="text-sm font-bold text-stone-800 uppercase tracking-wider">İçindekiler</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-stone-700">
              {item.ingredients.map((ing) => (
                <li class="flex items-center gap-2 bg-white p-2.5 rounded-xl border border-stone-200/80 shadow-xs">
                  <span class="text-[#D97706] font-bold">✓</span>
                  <span>{ing}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Allergens -->
          {item.allergens.length > 0 && (
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 space-y-1">
              <span class="text-xs font-bold text-[#B45309] uppercase tracking-wide">⚠️ Alerjen Uyarısı</span>
              <p class="text-xs text-stone-600">
                Bu ürün şu alerjenleri içerir: <strong>{item.allergens.join(', ')}</strong>. Çapraz bulaşma riski için lütfen şube personelimize danışınız.
              </p>
            </div>
          )}

          <!-- Branch Availability (Local SEO Links) -->
          <div class="bg-white border border-stone-200/90 rounded-2xl p-5 space-y-3 shadow-xs">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-stone-800 uppercase tracking-wider">Şubelerde Bulunabilirlik</h3>
              <span class="text-xs text-emerald-700 font-bold">● Tüm Şubelerde Mevcut</span>
            </div>
            <div class="flex flex-wrap gap-2">
              {branches.map((b) => (
                <a
                  href={`/subeler/${b.slug}`}
                  class="px-3 py-1.5 rounded-xl bg-stone-50 hover:bg-amber-50 border border-stone-200 text-xs font-bold text-stone-700 hover:text-[#B45309] transition-colors"
                >
                  📍 {b.name}
                </a>
              ))}
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href="/subeler"
              class="flex-1 text-center py-4 rounded-2xl bg-[#FFB800] text-[#1C1917] font-black text-sm hover:bg-[#F59E0B] shadow-lg shadow-amber-500/20 transition-transform hover:scale-102"
            >
              EN YAKIN ŞUBEDEN AL →
            </a>
            <a
              href="/menu"
              class="px-6 py-4 rounded-2xl border border-stone-300 text-stone-800 hover:text-stone-900 text-sm font-bold text-center transition-colors hover:bg-stone-100"
            >
              Tüm Menüye Dön
            </a>
          </div>

        </div>

      </div>

      <!-- Related Products -->
      {relatedItems.length > 0 && (
        <section class="mt-24 pt-16 border-t border-stone-200">
          <div class="flex items-center justify-between mb-8">
            <h2 class="text-2xl font-black text-[#1C1917] font-sans">
              BUNU SEVENLER <span class="text-[#D97706]">BUNLARI DA DENEDİ</span>
            </h2>
            <a href="/menu" class="text-xs font-bold text-[#D97706] hover:underline">
              Tümünü Gör →
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedItems.map((rItem) => (
              <ProductCard item={rItem} />
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</Layout>
