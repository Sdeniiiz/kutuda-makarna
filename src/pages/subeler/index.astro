---
import Layout from '../../layouts/Layout.astro';
import BranchFinder from '../../components/BranchFinder.astro';
import { branches } from '../../data/branches';

const branchesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Kutuda Makarna Restoran Zinciri Şubeleri',
  'itemListElement': branches.map((b, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'url': `https://kutudamakarna.com/subeler/${b.slug}`,
    'name': `${b.city} - ${b.name}`
  }))
};
---

<Layout
  title="Kutuda Makarna Şubeleri | İstanbul, Samsun, Ankara, İzmir, Bursa, Antalya"
  description="Kutuda Makarna şubeleri nerede? İstanbul, Samsun, Ankara, İzmir, Bursa ve Antalya restoran şubelerimizin adresleri, çalışma saatleri, telefonları ve yol tarifleri."
  canonical="https://kutudamakarna.com/subeler"
  activePath="/subeler"
  schemaJson={branchesSchema}
>
  <!-- Full Master Branch Finder Section -->
  <BranchFinder />
</Layout>
