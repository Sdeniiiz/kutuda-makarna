---
import Layout from '../../layouts/Layout.astro';
import { branches, type Branch } from '../../data/branches';

export function getStaticPaths() {
  return branches.map((branch) => ({
    params: { slug: branch.slug },
    props: { branch },
  }));
}

interface Props {
  branch: Branch;
}

const { branch } = Astro.props;

// LocalBusiness / FastFoodRestaurant JSON-LD Schema
const branchSchema = {
  '@context': 'https://schema.org',
  '@type': 'FastFoodRestaurant',
  'name': `Kutuda Makarna - ${branch.name}`,
  'image': 'https://kutudamakarna.com/images/kutuda-makarna-sube-konsepti.jpg',
  'url': `https://kutudamakarna.com/subeler/${branch.slug}`,
  'telephone': branch.phone,
  'priceRange': '₺₺',
  'servesCuisine': ['Italian', 'Pasta', 'Fast Casual'],
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': branch.address,
    'addressLocality': branch.district,
    'addressRegion': branch.city,
    'addressCountry': 'TR'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': branch.coordinates.lat,
    'longitude': branch.coordinates.lng
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '11:00',
      'closes': '00:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Saturday', 'Sunday'],
      'opens': '11:00',
      'closes': '01:00'
    }
  ],
  'menu': 'https://kutudamakarna.com/menu'
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Ana Sayfa',
      'item': 'https://kutudamakarna.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Şubelerimiz',
      'item': 'https://kutudamakarna.com/subeler'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': branch.name,
      'item': `https://kutudamakarna.com/subeler/${branch.slug}`
    }
  ]
};
---

<Layout
  title={`Kutuda Makarna ${branch.name} | Adres, Telefon & Yol Tarifi`}
  description={`Kutuda Makarna ${branch.name} nerede? ${branch.district} ${branch.city} şubesi adresi, çalışma saatleri, telefon numarası ve Google Haritalar yol tarifi.`}
  canonical={`https://kutudamakarna.com/subeler/${branch.slug}`}
  activePath="/subeler"
  schemaJson={[branchSchema, breadcrumbSchema]}
>
  <div class="py-10 lg:py-16 bg-[#0E0E10]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-8 text-xs font-semibold text-zinc-400">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-[#FFB800] transition-colors">Ana Sayfa</a></li>
          <li><span>/</span></li>
          <li><a href="/subeler" class="hover:text-[#FFB800] transition-colors">Şubelerimiz</a></li>
          <li><span>/</span></li>
          <li class="text-[#FFB800]">{branch.name}</li>
        </ol>
      </nav>

      <!-- Main Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left: NAP & Information -->
        <div class="lg:col-span-7 space-y-8">
          
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 text-xs font-bold mb-4">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Şu An Açık • Sıcak Servis Devam Ediyor</span>
            </div>
            
            <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-sans">
              KUTUDA MAKARNA <span class="text-[#FFB800]">{branch.name}</span>
            </h1>
            <p class="text-zinc-400 mt-3 text-base sm:text-lg">
              {branch.district} bölgesinde taze makarna, nefis soslar ve 3 dakikada hızlı teslimat lezzeti.
            </p>
          </div>

          <!-- Quick Contact & Hours Box -->
          <div class="bg-[#14141A] border border-zinc-800 rounded-2xl p-6 sm:p-8 space-y-6">
            
            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#FFB800]/10 border border-[#FFB800]/30 flex items-center justify-center text-[#FFB800] shrink-0 text-lg">
                📍
              </div>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400">Açık Adres</h3>
                <p class="text-sm font-semibold text-white mt-0.5 leading-relaxed">{branch.address}</p>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#FFB800]/10 border border-[#FFB800]/30 flex items-center justify-center text-[#FFB800] shrink-0 text-lg">
                📞
              </div>
              <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400">Sipariş & Bilgi Hattı</h3>
                <a href={`tel:${branch.phone}`} class="text-lg font-black text-[#FFB800] hover:underline font-mono mt-0.5 block">
                  {branch.phoneDisplay}
                </a>
                <span class="text-[11px] text-zinc-500">Gel-Al için önceden arayıp hazırlatabilirsiniz.</span>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-[#FFB800]/10 border border-[#FFB800]/30 flex items-center justify-center text-[#FFB800] shrink-0 text-lg">
                🕒
              </div>
              <div class="space-y-1">
                <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400">Çalışma Saatleri</h3>
                <div class="text-sm text-zinc-200">
                  <span class="font-medium text-white">Hafta İçi:</span> {branch.workingHours.weekdays}
                </div>
                <div class="text-sm text-zinc-200">
                  <span class="font-medium text-white">Hafta Sonu:</span> {branch.workingHours.weekend}
                </div>
                {branch.workingHours.note && (
                  <p class="text-xs text-[#FFB800] pt-1">💡 {branch.workingHours.note}</p>
                )}
              </div>
            </div>

          </div>

          <!-- Directions & Transportation Guide -->
          <div class="space-y-4">
            <h2 class="text-xl font-bold text-white uppercase tracking-wider border-l-2 border-[#FFB800] pl-3">
              Nasıl Gidilir? (Ulaşım Rehberi)
            </h2>
            <div class="bg-[#16161C] border border-zinc-800 rounded-2xl p-6 text-sm text-zinc-300 leading-relaxed">
              <p>{branch.directionsGuide}</p>
            </div>
          </div>

          <!-- Nearby Landmarks (Local SEO Booster) -->
          <div class="space-y-3">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">
              {branch.district} Yakınındaki Önemli Noktalar
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-zinc-300">
              {branch.nearbySpots.map((spot) => (
                <div class="bg-zinc-900/80 border border-zinc-800 p-3 rounded-xl flex items-center gap-2.5">
                  <span class="text-[#FFB800]">📌</span>
                  <span>{spot}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Branch FAQs -->
          {branch.faqs.length > 0 && (
            <div class="space-y-4 pt-4">
              <h2 class="text-xl font-bold text-white uppercase tracking-wider border-l-2 border-[#FFB800] pl-3">
                {branch.name} Hakkında Sıkça Sorulanlar
              </h2>
              <div class="space-y-3">
                {branch.faqs.map((f) => (
                  <div class="bg-[#14141A] border border-zinc-800 rounded-xl p-5 space-y-2">
                    <h4 class="text-sm font-bold text-white">{f.question}</h4>
                    <p class="text-xs text-zinc-400 leading-relaxed">{f.answer}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- Right: Map Card & Fast Actions -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Storefront Photo Card -->
          <div class="relative rounded-2xl overflow-hidden border border-zinc-800 bg-[#14141A] shadow-xl">
            <img
              src="/images/kutuda-makarna-sube-konsepti.jpg"
              alt={`Kutuda Makarna ${branch.name} Mağaza Görünümü`}
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <div class="p-5 bg-gradient-to-t from-[#14141A] to-transparent">
              <span class="text-xs font-bold text-[#FFB800] uppercase tracking-wider block">Kiosk & Oturma Alanı</span>
              <p class="text-xs text-zinc-300 mt-1">Sıcak ahşap ve neon sarı atmosferimizle sizleri bekliyoruz.</p>
            </div>
          </div>

          <!-- Quick Action Buttons -->
          <div class="bg-[#14141A] border border-zinc-800 rounded-2xl p-6 space-y-4">
            <h3 class="text-base font-bold text-white">Hızlı İşlemler</h3>
            
            <a
              href={branch.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-sm flex items-center justify-center gap-2 hover:bg-[#F59E0B] shadow-lg shadow-[#FFB800]/25 transition-transform hover:scale-102"
            >
              <span>GOOGLE HARİTALAR'DA AÇ</span>
              <span>↗</span>
            </a>

            <a
              href={`tel:${branch.phone}`}
              class="w-full py-3.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-white font-bold text-sm flex items-center justify-center gap-2 transition-colors border border-zinc-700"
            >
              <span>TELEFONLA SİPARİŞ VER</span>
              <span>📞</span>
            </a>

            <a
              href="/menu"
              class="w-full py-3.5 rounded-xl border border-zinc-700 hover:border-[#FFB800] text-zinc-200 hover:text-white font-bold text-sm flex items-center justify-center gap-2 transition-colors"
            >
              <span>ŞUBE MENÜSÜNÜ İNCELE</span>
              <span>🍝</span>
            </a>
          </div>

          <!-- Other Branches Navigation -->
          <div class="bg-[#14141A] border border-zinc-800 rounded-2xl p-6 space-y-4">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Diğer Samsun Şubelerimiz</h3>
            <div class="space-y-2">
              {branches.filter(b => b.slug !== branch.slug).map(ob => (
                <a
                  href={`/subeler/${ob.slug}`}
                  class="flex items-center justify-between p-3 rounded-xl bg-zinc-900/60 hover:bg-zinc-800 border border-zinc-800 text-xs font-semibold text-zinc-300 hover:text-white transition-colors"
                >
                  <span>{ob.name}</span>
                  <span class="text-[#FFB800]">İncele →</span>
                </a>
              ))}
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</Layout>
