---
import Layout from '../../layouts/Layout.astro';
import { getAllBranches, getBranchBySlug } from '../../services/branchService';
import { getBranchProducts } from '../../services/productService';
import { getBranchCampaigns } from '../../services/campaignService';
import BranchHero from '../../components/branches/BranchHero.astro';
import BranchInfo from '../../components/branches/BranchInfo.astro';
import BranchOrderCTA from '../../components/branches/BranchOrderCTA.astro';
import BranchMap from '../../components/branches/BranchMap.astro';
import CampaignSection from '../../components/campaigns/CampaignSection.astro';
import ProductCard from '../../components/ProductCard.astro';
import WhyBox from '../../components/WhyBox.astro';
import type { BranchAggregate } from '../../types/branch';

export function getStaticPaths() {
  const branches = getAllBranches();
  return branches.map((branch) => ({
    params: { slug: branch.slug },
    props: { branch },
  }));
}

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
const branchProducts = getBranchProducts(branch.slug);
const branchCampaigns = getBranchCampaigns(branch.slug);
const availableMenu = branchProducts.filter(p => p.isAvailable);

// LocalBusiness / FastFoodRestaurant JSON-LD Schema
const branchSchema = {
  '@context': 'https://schema.org',
  '@type': 'FastFoodRestaurant',
  'name': `Kutuda Makarna - ${branch.name}`,
  'image': `https://kutudamakarna.com${branch.branding?.heroImage?.desktop || branch.image}`,
  'url': `https://kutudamakarna.com/subeler/${branch.slug}`,
  'telephone': branch.contact?.phone || branch.phone,
  'priceRange': '₺₺',
  'servesCuisine': ['Italian', 'Pasta', 'Fast Casual'],
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': branch.location?.address || branch.address,
    'addressLocality': branch.location?.district || branch.district,
    'addressRegion': branch.location?.city || branch.city,
    'addressCountry': 'TR'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': branch.location?.coordinates.lat || branch.coordinates.lat,
    'longitude': branch.location?.coordinates.lng || branch.coordinates.lng
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      'opens': '11:00',
      'closes': '00:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Saturday', 'Sunday'],
      'opens': '11:00',
      'closes': '01:00'
    }
  ],
  'menu': `https://kutudamakarna.com/subeler/${branch.slug}#menu`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Ana Sayfa',
      'item': 'https://kutudamakarna.com/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Şubelerimiz',
      'item': 'https://kutudamakarna.com/subeler'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': branch.name,
      'item': `https://kutudamakarna.com/subeler/${branch.slug}`
    }
  ]
};
---

<Layout
  title={branch.seo?.metaTitle || `Kutuda Makarna ${branch.name} | Adres, Menü & Sipariş`}
  description={branch.seo?.metaDescription || `Kutuda Makarna ${branch.name} nerede? ${branch.district} ${branch.city} şubesi adresi, çalışma saatleri, telefon numarası ve yol tarifi.`}
  canonical={branch.seo?.canonicalUrl || `https://kutudamakarna.com/subeler/${branch.slug}`}
  activePath="/subeler"
  schemaJson={[branchSchema, breadcrumbSchema]}
>
  <div class="py-8 lg:py-14 bg-[#FBF9F5]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Navigation & Quick Switcher -->
      <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
        <nav aria-label="Breadcrumb" class="text-xs font-semibold text-stone-500">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-[#D97706] transition-colors">Ana Sayfa</a></li>
            <li><span class="text-stone-300">/</span></li>
            <li><a href="/subeler" class="hover:text-[#D97706] transition-colors">Şubelerimiz</a></li>
            <li><span class="text-stone-300">/</span></li>
            <li class="text-[#D97706] font-bold">{branch.name}</li>
          </ol>
        </nav>

        <button
          type="button"
          data-open-branch-selector
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200 hover:border-amber-400 text-xs font-bold text-stone-700 shadow-2xs hover:shadow-xs transition-all cursor-pointer"
        >
          <span>📍 Şube Değiştir: <strong>{branch.name}</strong></span>
          <span class="text-[#D97706]">▼</span>
        </button>
      </div>

      <!-- Announcement Banner (If active for this branch) -->
      {branch.theme?.announcementBanner?.isActive && (
        <div class="mb-8 p-4 rounded-2xl bg-amber-50 border border-amber-200/80 flex items-center justify-between gap-4 text-xs font-bold text-[#92400E]">
          <div class="flex items-center gap-2.5">
            <span class="text-base">📢</span>
            <span>{branch.theme.announcementBanner.text}</span>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-amber-100 text-[10px] font-black uppercase tracking-wider">ŞUBE DUYURUSU</span>
        </div>
      )}

      <!-- 1. Engine Component: Branch Hero -->
      <BranchHero branch={branch} />

      <!-- 2. Main Two-Column Engine Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left Column: Campaigns, Menu, Highlights, FAQs -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- Branch Active Campaigns -->
          {branchCampaigns.length > 0 && (
            <CampaignSection campaigns={branchCampaigns} branchName={branch.name} />
          )}

          <!-- Branch Menu Grid (Auto-Resolved with Branch Prices) -->
          <section id="menu" class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-stone-200/80 pb-4">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-amber-100 text-[#B45309] text-[10px] font-black uppercase tracking-wider mb-2">
                  <span>🍝 GÜNCEL ŞUBE MENÜSÜ</span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-[#1C1917] tracking-tight">
                  {branch.name} Lezzetleri
                </h2>
              </div>
              <span class="text-xs text-stone-500 font-mono">
                {availableMenu.length} Çeşit Hazır • 3 Dk Servis
              </span>
            </div>

            <!-- Product Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {availableMenu.map((item) => (
                <ProductCard item={item as any} />
              ))}
            </div>
          </section>

          <!-- Branch Highlights -->
          {branch.highlights && branch.highlights.length > 0 && (
            <section class="bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 space-y-4 shadow-sm">
              <h3 class="text-lg font-black text-[#1C1917] tracking-tight flex items-center gap-2">
                <span>⭐</span>
                <span>Bu Şubenin Öne Çıkan Özellikleri</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {branch.highlights.map((h) => (
                  <div class="flex items-start gap-3 p-3 rounded-2xl bg-stone-50 border border-stone-100 text-xs font-semibold text-stone-700">
                    <span class="text-[#D97706] text-sm">✓</span>
                    <span>{h}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- Branch Specific FAQs -->
          {branch.faqs && branch.faqs.length > 0 && (
            <section class="space-y-4">
              <h3 class="text-xl font-black text-[#1C1917] tracking-tight flex items-center gap-2">
                <span>❓</span>
                <span>{branch.name} Hakkında Sıkça Sorulanlar</span>
              </h3>
              <div class="space-y-3">
                {branch.faqs.map((faq) => (
                  <details class="group bg-white border border-stone-200/90 rounded-2xl overflow-hidden transition-all hover:border-amber-400/60 shadow-2xs">
                    <summary class="flex items-center justify-between p-5 text-left font-bold text-[#1C1917] cursor-pointer select-none group-open:text-[#D97706] list-none text-sm">
                      <span>{faq.question}</span>
                      <span class="w-6 h-6 rounded-full bg-stone-100 flex items-center justify-center text-xs text-[#D97706] group-open:rotate-180 transition-transform shrink-0 ml-2">
                        ▼
                      </span>
                    </summary>
                    <div class="px-5 pb-5 text-xs sm:text-sm text-stone-600 leading-relaxed border-t border-stone-100 pt-3">
                      {faq.answer}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Directions and Transportation Guide -->
          <BranchMap location={branch.location} branchName={branch.name} />

        </div>

        <!-- Right Column: Sticky Operational Card & Order CTAs -->
        <div class="lg:col-span-4 space-y-6">
          <div class="sticky top-24 space-y-6">
            <!-- 3. Engine Component: Ordering Channels -->
            <BranchOrderCTA
              orderSettings={branch.orderSettings}
              contact={branch.contact}
              branchName={branch.name}
            />

            <!-- 4. Engine Component: Operational NAP & Hours -->
            <BranchInfo branch={branch} />
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Global Brand Section: Why Box (Reusable) -->
  <WhyBox />
</Layout>
