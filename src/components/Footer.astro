---
import { branches } from '../data/branches';
---

<footer class="bg-[#1C1917] border-t border-stone-800 text-stone-400 text-sm">
  <!-- Top Highlight Bar -->
  <div class="border-b border-stone-800/80 py-8 bg-[#161413]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-[#FFB800]/15 border border-[#FFB800]/30 flex items-center justify-center text-[#FFB800]">
          <span class="text-2xl">📦</span>
        </div>
        <div>
          <h3 class="text-white font-bold text-lg">Canın Sıcak Bir Kutu Makarna mı Çekti?</h3>
          <p class="text-stone-400 text-xs sm:text-sm">Taze al dente makarna, yoğun sos ve sıcacık lezzet seni bekliyor.</p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/menu"
          class="px-6 py-2.5 rounded-xl bg-[#FFB800] text-[#1C1917] font-black text-sm hover:bg-[#F59E0B] transition-all hover:scale-105"
        >
          Menüyü İncele
        </a>
        <a
          href="/subeler"
          class="px-6 py-2.5 rounded-xl border border-stone-700 hover:border-amber-400 text-stone-200 font-bold text-sm transition-all"
        >
          Şubeleri Gör
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
    <!-- Col 1: Brand & Philosophy -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-xl bg-[#FFB800] flex items-center justify-center text-[#1C1917] font-black text-sm">
          KM
        </div>
        <span class="text-white font-black text-lg tracking-wider uppercase">Kutuda <span class="text-[#FFB800]">Makarna</span></span>
      </div>
      <p class="text-stone-400 text-sm leading-relaxed max-w-sm">
        Taze durum buğdayı irmiğinden hazırlanan günlük el yapımı makarnalarımız, anında sipariş üzerine tavada pişen gurme soslarla kutuda buluşuyor. Sokakta, sahilde, ofiste; al dente lezzet her an seninle.
      </p>
      <div class="pt-3 flex items-center gap-4">
        <a
          href="https://instagram.com/kutudamakarna"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-bold text-stone-300 hover:text-[#FFB800] transition-colors bg-white/5 px-3 py-1.5 rounded-lg border border-white/10"
        >
          <svg class="w-4 h-4 fill-current text-[#E4405F]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@kutudamakarna</span>
        </a>
      </div>
    </div>

    <!-- Col 2: Hızlı Menü -->
    <div>
      <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-2 border-[#FFB800] pl-2">Menümüz</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/menu/kremali-mantarli-makarna" class="hover:text-[#FFB800] transition-colors">Kremalı Mantarlı</a></li>
        <li><a href="/menu/bolonez-makarna" class="hover:text-[#FFB800] transition-colors">Geleneksel Bolonez</a></li>
        <li><a href="/menu/acili-arrabbiata-makarna" class="hover:text-[#FFB800] transition-colors">Acılı Arrabbiata</a></li>
        <li><a href="/menu/pesto-makarna" class="hover:text-[#FFB800] transition-colors">Taze Fesleğenli Pesto</a></li>
        <li><a href="/menu/dort-peynirli-makarna" class="hover:text-[#FFB800] transition-colors">Dört Peynirli Gurme</a></li>
        <li><a href="/menu" class="text-[#FFB800] hover:underline font-semibold pt-1 inline-block">Tüm Menüyü Gör →</a></li>
      </ul>
    </div>

    <!-- Col 3: Samsun Şubeleri -->
    <div>
      <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-2 border-[#FFB800] pl-2">Şubelerimiz</h4>
      <ul class="space-y-2.5 text-sm">
        {branches.map((b) => (
          <li>
            <a href={`/subeler/${b.slug}`} class="hover:text-[#FFB800] transition-colors flex items-center justify-between group">
              <span>{b.name}</span>
              <span class="text-[10px] text-stone-500 font-mono group-hover:text-[#FFB800]">{b.district}</span>
            </a>
          </li>
        ))}
        <li><a href="/subeler" class="text-[#FFB800] hover:underline font-semibold pt-1 inline-block">Yol Tarifleri & Harita →</a></li>
      </ul>
    </div>

    <!-- Col 4: Kurumsal & Destek -->
    <div>
      <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 border-l-2 border-[#FFB800] pl-2">Kurumsal</h4>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/hakkimizda" class="hover:text-[#FFB800] transition-colors">Hikayemiz & Neden Kutu?</a></li>
        <li><a href="/franchise" class="hover:text-[#FFB800] transition-colors font-bold text-[#FFB800]">Franchise Ortaklığı</a></li>
        <li><a href="/makarna" class="hover:text-[#FFB800] transition-colors">Makarna Rehberi</a></li>
        <li><a href="/iletisim" class="hover:text-[#FFB800] transition-colors">İletişim & Şubeler</a></li>
        <li class="pt-2 text-xs text-stone-400">
          Müşteri Hattı:<br />
          <a href="tel:+903625000101" class="text-[#FFB800] font-mono font-bold hover:underline">0 (362) 500 01 01</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="border-t border-stone-800/80 py-6 bg-[#141211]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p>© {new Date().getFullYear()} Kutuda Makarna. Tüm hakları saklıdır. Lezzet Kutuda Saklı!</p>
      <div class="flex items-center gap-6">
        <a href="/hakkimizda" class="hover:text-stone-400 transition-colors">KVKK & Gizlilik</a>
        <a href="/hakkimizda" class="hover:text-stone-400 transition-colors">Kullanım Koşulları</a>
        <a href="/admin" class="hover:text-[#FFB800] text-stone-400 font-medium transition-colors">HQ Yönetici Girişi 🔒</a>
      </div>
    </div>
  </div>
</footer>
