---
import { menuItems, getDailySpecial } from '../data/menu';
import { categories } from '../data/categories';

const dailySpecial = getDailySpecial();
const otherItems = menuItems.filter(item => item.slug !== dailySpecial.slug);
---

<section id="menu" class="py-20 sm:py-32 bg-[#F4EFEA] border-b border-stone-200/80 w-full overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 1. BUGÜNÜN MAKARNASI (TODAY'S PASTA SPOTLIGHT) -->
    <div class="mb-16 sm:mb-24">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFB800]/20 border border-amber-500/30 text-[#B45309] text-xs font-black uppercase tracking-widest mb-4">
        <span>⭐</span>
        <span>ŞEFİN GÜNLÜK SEÇİMİ</span>
      </div>
      
      <div class="bg-[#1C1917] text-white rounded-3xl overflow-hidden border border-stone-800 shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 items-center">
          
          <!-- Image Side -->
          <div class="lg:col-span-6 relative aspect-[16/10] sm:aspect-[16/11] overflow-hidden group">
            <img
              src={dailySpecial.image}
              alt={dailySpecial.name}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-106"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            
            <div class="absolute top-4 left-4">
              <span class="px-3.5 py-1.5 rounded-full bg-[#FFB800] text-[#1C1917] text-xs font-black uppercase tracking-wider shadow-lg">
                ⭐ BUGÜNÜN MAKARNASI
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-stone-300">
              <span class="font-mono bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-lg">
                {dailySpecial.portionGrams}g • {dailySpecial.pastaType}
              </span>
              <span class="font-mono font-bold text-amber-400 bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-lg">
                3 Dk Hazır
              </span>
            </div>
          </div>

          <!-- Content Side -->
          <div class="lg:col-span-6 p-6 sm:p-10 space-y-5">
            <div>
              <span class="text-xs font-bold text-[#FFB800] uppercase tracking-wider block mb-1">
                Günün Sıcak Tavsiye Tabağı
              </span>
              <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight uppercase font-sans">
                {dailySpecial.name}
              </h2>
            </div>

            <p class="text-stone-300 text-sm sm:text-base leading-relaxed font-light">
              {dailySpecial.description}
            </p>

            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 text-xs text-stone-300 space-y-1">
              <span class="font-bold text-amber-400">Sos Reçetesi:</span>
              <p>{dailySpecial.sauceDetails}</p>
            </div>

            <div class="pt-2 flex flex-col xs:flex-row items-center justify-between gap-4">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-black text-[#FFB800] font-mono">{dailySpecial.price} ₺</span>
                <span class="text-xs text-stone-400">/ porsiyon</span>
              </div>

              <div class="flex items-center gap-3 w-full xs:w-auto">
                <a
                  href={`/menu/${dailySpecial.slug}`}
                  class="flex-1 xs:flex-none text-center px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold uppercase transition-colors"
                >
                  Detayları Gör
                </a>
                <button
                  type="button"
                  data-open-online-order-modal
                  class="flex-1 xs:flex-none text-center px-6 py-3 rounded-xl bg-[#FFB800] hover:bg-[#F59E0B] text-[#1C1917] text-xs font-black uppercase transition-transform hover:scale-105 shadow-md cursor-pointer"
                >
                  Sipariş Ver →
                </button>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>

    <!-- 2. MAKARNA VE İÇECEK SEÇKİSİ -->
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
      <h3 class="text-2xl sm:text-4xl font-black text-[#1C1917] tracking-tight uppercase font-sans">
        MAKARNALAR & İÇECEKLER
      </h3>
      <p class="text-xs sm:text-sm text-stone-600">
        Katkısız taze durum buğdayı makarnaları ve ev yapımı serinletici içecekler.
      </p>
    </div>

    <!-- Category Filter Tabs (Makarna & İçecek) -->
    <div class="flex items-center justify-center gap-2 sm:gap-3 flex-wrap mb-10" id="home-category-tabs">
      <button
        type="button"
        data-cat-filter="all"
        class="home-cat-btn px-5 sm:px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-[#1C1917] text-white shadow-sm"
      >
        Tümü ({menuItems.length})
      </button>
      {categories.map((cat) => (
        <button
          type="button"
          data-cat-filter={cat.id}
          class="home-cat-btn px-5 sm:px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-stone-700 hover:bg-stone-100 border border-stone-200"
        >
          <span class="mr-1.5">{cat.icon}</span>
          <span>{cat.name}</span>
        </button>
      ))}
    </div>

    <!-- Products Grid (Responsive & Mobile-Safe) -->
    <div id="home-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {otherItems.map((item) => (
        <div
          data-item-cat={item.category}
          class="home-menu-card group relative bg-white rounded-3xl overflow-hidden border border-stone-200/90 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
        >
          <!-- Top Food Image with Zoom on Hover -->
          <div class="relative w-full aspect-[4/3] overflow-hidden bg-stone-100">
            <img
              src={item.image}
              alt={item.name}
              class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-108"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-40 group-hover:opacity-60 transition-opacity"></div>

            <!-- Optional Badge -->
            {item.badge && (
              <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-[#FFB800] text-[#1C1917] text-[11px] font-black tracking-wide shadow-md">
                {item.badge}
              </span>
            )}

            <!-- Price Tag -->
            <span class="absolute bottom-4 right-4 px-3.5 py-1.5 rounded-xl bg-black/80 backdrop-blur-md text-white text-sm font-black font-mono shadow-md border border-white/10">
              {item.price} ₺
            </span>
          </div>

          <!-- Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-[#B45309] mb-1">
                <span>{item.categoryName}</span>
                <span>{item.portionGrams}g</span>
              </div>

              <h4 class="text-xl font-black text-[#1C1917] group-hover:text-[#D97706] transition-colors leading-snug">
                {item.name}
              </h4>

              <p class="text-xs sm:text-sm text-stone-500 mt-2 line-clamp-2 leading-relaxed">
                {item.shortDescription}
              </p>
            </div>

            <!-- Culinary Specs Line & Action -->
            <div class="pt-4 border-t border-stone-100 flex items-center justify-between">
              <span class="text-[11px] font-bold text-stone-400">
                {item.prepTimeMinutes} Dk • Al Dente
              </span>

              <a
                href={`/menu/${item.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-black uppercase text-[#D97706] hover:text-[#B45309] group-hover:translate-x-1 transition-transform"
              >
                <span>Detayları Gör</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Full Menu CTA -->
    <div class="mt-12 text-center">
      <a
        href="/menu"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-[#1C1917] hover:bg-[#D97706] text-white font-black text-xs uppercase tracking-wider shadow-lg transition-all hover:scale-102"
      >
        <span>TÜM MENÜ VE BESİN DEĞERLERİNİ İNCELE</span>
        <span>→</span>
      </a>
    </div>

  </div>
</section>

<script>
  function setupCategoryFiltering() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.home-cat-btn');
    const cards = document.querySelectorAll<HTMLElement>('.home-menu-card');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-cat-filter');

        // Toggle active button styles
        tabs.forEach((t) => {
          t.classList.remove('bg-[#1C1917]', 'text-white');
          t.classList.add('bg-white', 'text-stone-700');
        });
        tab.classList.remove('bg-white', 'text-stone-700');
        tab.classList.add('bg-[#1C1917]', 'text-white');

        // Filter cards
        cards.forEach((card) => {
          const itemCat = card.getAttribute('data-item-cat');
          if (filter === 'all' || itemCat === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCategoryFiltering);
  } else {
    setupCategoryFiltering();
  }
</script>
