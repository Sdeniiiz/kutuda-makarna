---
---

<section id="hero-section" class="relative min-h-[90vh] lg:min-h-[94vh] flex flex-col justify-between overflow-hidden bg-gradient-to-b from-[#0A0A0D] via-[#101015] to-[#0A0A0D] pt-8 pb-12">
  <!-- Subtle Amber Radial Backlight -->
  <div id="hero-bg-glow" class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-[#FFB800]/12 rounded-full blur-[150px] pointer-events-none transition-transform duration-700"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex-1 flex items-center relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center w-full py-8">
      
      <!-- Left Column: Branding, Big Punchy Typography, CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Small Label -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-black uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-[#FFB800] animate-ping"></span>
          <span>KUTUDA MAKARNA</span>
        </div>

        <!-- Big H1 -->
        <h1 class="text-5xl sm:text-7xl xl:text-8xl font-black text-white tracking-tight leading-[0.98] font-sans">
          MAKARNA<br />
          <span class="text-[#FFB800] inline-block mt-1">KUTUDA.</span>
        </h1>

        <!-- Short, Ferah Alt Metin -->
        <p class="text-lg sm:text-2xl text-zinc-300 font-normal leading-relaxed max-w-xl mx-auto lg:mx-0">
          Taze makarna. Bol sos.<br class="hidden sm:inline" />
          Kutuda yepyeni bir lezzet deneyimi.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-3 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="/menu"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#FFB800] text-[#0A0A0D] font-black text-base hover:bg-[#F59E0B] shadow-xl shadow-[#FFB800]/25 transition-all hover:scale-105 active:scale-95 group"
          >
            <span>MENÜYÜ GÖR</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <a
            href="/subeler"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-[#14141A] border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-base transition-all hover:bg-zinc-800/90"
          >
            <svg class="w-5 h-5 text-[#FFB800]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>EN YAKIN ŞUBE</span>
          </a>
        </div>

        <!-- Trust Features Strip -->
        <div class="pt-6 border-t border-zinc-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-zinc-400 font-medium">
          <span class="flex items-center gap-2">
            <span class="text-[#FFB800]">✓</span> 3 Dakikada Tavadan Kutuya
          </span>
          <span class="flex items-center gap-2">
            <span class="text-[#FFB800]">✓</span> %100 Taze Durum Hamuru
          </span>
          <span class="flex items-center gap-2">
            <span class="text-[#FFB800]">✓</span> 30 Dk Sıcak Kalan Kutu
          </span>
        </div>
      </div>

      <!-- Right Column: Big Realistic Takeout Box with Mouse Tilt Parallax -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        
        <!-- Floating Micro Badges -->
        <div class="absolute -top-3 left-4 z-20 bg-zinc-900/90 backdrop-blur-md border border-[#FFB800]/40 px-3.5 py-1.5 rounded-full shadow-xl flex items-center gap-2">
          <span class="text-xs font-bold text-white tracking-wide">🔥 Al Dente & Sıcacık</span>
        </div>

        <div class="absolute bottom-6 right-2 z-20 bg-zinc-900/90 backdrop-blur-md border border-zinc-800 px-4 py-2 rounded-xl shadow-xl flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#FFB800]/20 flex items-center justify-center text-[#FFB800] text-sm">
            🍝
          </div>
          <div>
            <div class="text-[11px] text-zinc-400">Özel Termo-Kutu</div>
            <div class="text-xs font-bold text-white">Sos Dibe Çökmez</div>
          </div>
        </div>

        <!-- The Hero Product Visual Container (Receives Tilt Parallax) -->
        <div
          id="hero-product-box"
          class="relative w-full max-w-[440px] aspect-square rounded-3xl bg-gradient-to-b from-[#181822] via-[#121218] to-[#0A0A0D] border-2 border-[rgba(255,184,0,0.35)] shadow-2xl p-6 flex flex-col items-center justify-center overflow-hidden transition-transform duration-200 ease-out box-shadow-glow"
        >
          <!-- Internal ambient glow -->
          <div class="absolute inset-0 bg-radial from-[#FFB800]/20 via-transparent to-transparent opacity-70"></div>

          <!-- Rising Steam Paths (Looping CSS) -->
          <div class="absolute top-10 z-10 flex gap-6 pointer-events-none">
            <svg class="w-8 h-18 text-zinc-400 animate-steam-1" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 55 C 6 45, 18 35, 12 25 C 6 15, 18 5, 12 0" />
            </svg>
            <svg class="w-8 h-18 text-zinc-300 animate-steam-2" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M12 55 C 18 45, 6 35, 12 25 C 18 15, 6 5, 12 0" />
            </svg>
            <svg class="w-8 h-18 text-zinc-400 animate-steam-3" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 55 C 8 45, 16 35, 12 25 C 8 15, 16 5, 12 0" />
            </svg>
          </div>

          <!-- Large High-Fidelity Takeout Box Vector -->
          <div class="relative z-10 w-72 h-72 flex items-center justify-center">
            <svg viewBox="0 0 260 260" class="w-full h-full drop-shadow-2xl overflow-visible">
              <defs>
                <linearGradient id="heroBoxFront" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFB800" />
                  <stop offset="100%" stop-color="#D97706" />
                </linearGradient>
                <linearGradient id="heroBoxSide" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#B45309" />
                  <stop offset="100%" stop-color="#78350F" />
                </linearGradient>
                <linearGradient id="heroPasta" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFFBEB" />
                  <stop offset="100%" stop-color="#FDE68A" />
                </linearGradient>
              </defs>

              <!-- Floor Shadow -->
              <ellipse cx="130" cy="225" rx="85" ry="20" fill="rgba(0,0,0,0.6)" />

              <!-- Box Lower Body -->
              <polygon points="65,115 195,115 175,215 85,215" fill="url(#heroBoxFront)" />
              <polygon points="195,115 218,100 196,198 175,215" fill="url(#heroBoxSide)" opacity="0.88" />

              <!-- Brand Logo Emblem On Box Body -->
              <rect x="105" y="145" width="55" height="42" rx="7" fill="#0A0A0D" opacity="0.95" />
              <text x="132" y="163" fill="#FFB800" font-size="9" font-weight="900" text-anchor="middle" font-family="sans-serif">KUTUDA</text>
              <text x="132" y="177" fill="#FFFFFF" font-size="9" font-weight="900" text-anchor="middle" font-family="sans-serif">MAKARNA</text>

              <!-- Box Flaps Open (Left & Right) -->
              <polygon points="65,115 35,75 100,90 90,115" fill="#F59E0B" />
              <polygon points="195,115 225,75 160,90 170,115" fill="#D97706" />

              <!-- Overflowing Fresh Pasta Noodles -->
              <path d="M 80 115 Q 130 70 180 115 Q 150 60 110 88 Z" fill="url(#heroPasta)" />

              <!-- Sauce Swirls & Basil Garnish -->
              <path d="M 90 98 Q 130 68 170 100" stroke="#DC2626" stroke-width="7" stroke-linecap="round" fill="none" />
              <path d="M 102 110 Q 130 85 160 112" stroke="#F59E0B" stroke-width="5" stroke-linecap="round" fill="none" />
              <circle cx="128" cy="90" r="5" fill="#16A34A" /> <!-- Fresh basil -->
              <circle cx="145" cy="96" r="4" fill="#22C55E" /> <!-- Fresh basil -->

              <!-- Fork picking delicious pasta strand -->
              <g transform="translate(155, 30) rotate(22)">
                <rect x="0" y="0" width="9" height="70" rx="4" fill="#E4E4E7" />
                <path d="M -7 0 L 16 0 L 12 24 L -3 24 Z" fill="#E4E4E7" />
                <line x1="-4" y1="0" x2="-4" y2="-18" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
                <line x1="1" y1="0" x2="1" y2="-22" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
                <line x1="6" y1="0" x2="6" y2="-22" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
                <line x1="11" y1="0" x2="11" y2="-18" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
              </g>
            </svg>
          </div>

          <div class="relative z-10 text-center mt-2">
            <span class="text-xs uppercase tracking-widest text-[#FFB800] font-black">LEZZET KUTUDA SAKLI</span>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Animated Scroll Down Indicator -->
  <div class="relative z-10 flex flex-col items-center justify-center gap-1.5 text-zinc-500 hover:text-[#FFB800] transition-colors cursor-pointer pt-4">
    <a href="#pasta-box-experience" class="flex flex-col items-center gap-1 group focus:outline-none" aria-label="Kutu Deneyimine Kaydır">
      <span class="text-[11px] font-black uppercase tracking-widest group-hover:text-[#FFB800] transition-colors">SCROLL</span>
      <div class="w-6 h-6 rounded-full border border-zinc-700 group-hover:border-[#FFB800] flex items-center justify-center animate-float-down">
        <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-[#FFB800]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </div>
    </a>
  </div>
</section>

<!-- Desktop Parallax Tilt Script -->
<script>
  const heroSection = document.getElementById('hero-section');
  const productBox = document.getElementById('hero-product-box');
  const bgGlow = document.getElementById('hero-bg-glow');

  // Only enable on desktop with hover capability and without reduced-motion
  const hasFinePointer = window.matchMedia('(pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hasFinePointer && !prefersReducedMotion && heroSection && productBox && bgGlow) {
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5; // -0.5 to 0.5
      const y = (e.clientY - rect.top) / rect.height - 0.5;

      // Subtle parallax movement: 3-4px for product, 1px for background
      productBox.style.transform = `translate3d(${x * 8}px, ${y * 8}px, 0) rotateX(${-y * 4}deg) rotateY(${x * 4}deg)`;
      bgGlow.style.transform = `translate(calc(-50% + ${x * 15}px), calc(-50% + ${y * 15}px))`;
    });

    heroSection.addEventListener('mouseleave', () => {
      productBox.style.transform = 'translate3d(0, 0, 0) rotateX(0) rotateY(0)';
      bgGlow.style.transform = 'translate(-50%, -50%)';
    });
  }
</script>
