---
---

<section class="relative overflow-hidden pt-8 pb-16 lg:py-24 bg-gradient-to-b from-[#0E0E10] via-[#121216] to-[#0E0E10]">
  <!-- Ambient Amber Glow Background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#FFB800]/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Branding, H1, Pitch, CTAs -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Top Micro Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-bold uppercase tracking-wider">
          <span class="animate-pulse">🔥</span>
          <span>Samsun'un İlk Gurme Kutu Makarna Konsepti</span>
        </div>

        <!-- Main H1 -->
        <h1 class="text-4xl sm:text-6xl xl:text-7xl font-black text-white tracking-tight leading-[1.08] font-sans">
          MAKARNA <span class="text-[#FFB800] underline decoration-[#FFB800]/40 decoration-wavy decoration-2">KUTUDA</span>,<br />
          LEZZET AKLINDA.
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-zinc-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Taze makarna hamuru, tavadaki taze soslar ve kutuya sığmayan lezzet. 3 dakikada hazır, dilediğin an sokakta, sahilde veya şubelerimizde.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a
            href="/menu"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-base hover:bg-[#F59E0B] shadow-xl shadow-[#FFB800]/25 transition-all hover:scale-105 active:scale-95 group"
          >
            <span>MENÜYÜ GÖR</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <a
            href="/subeler"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-zinc-900 border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-base transition-all hover:bg-zinc-800"
          >
            <svg class="w-5 h-5 text-[#FFB800]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>EN YAKIN ŞUBE</span>
          </a>
        </div>

        <!-- Social Proof Numbers -->
        <div class="pt-6 border-t border-zinc-800/80 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0 text-left">
          <div class="bg-zinc-900/50 p-3 rounded-lg border border-zinc-800">
            <div class="text-[#FFB800] font-black text-xl sm:text-2xl">3 Dk</div>
            <div class="text-zinc-400 text-xs font-medium">Hızlı Servis</div>
          </div>
          <div class="bg-zinc-900/50 p-3 rounded-lg border border-zinc-800">
            <div class="text-white font-black text-xl sm:text-2xl">%100</div>
            <div class="text-zinc-400 text-xs font-medium">Taze Durum Hamuru</div>
          </div>
          <div class="bg-zinc-900/50 p-3 rounded-lg border border-zinc-800">
            <div class="text-[#FFB800] font-black text-xl sm:text-2xl">3 Şube</div>
            <div class="text-zinc-400 text-xs font-medium">Atakum • İlkadım • Tekkeköy</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Visual Box Hero with SVG Steam and Isometric Art -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <!-- Floating Badges -->
        <div class="absolute -top-4 -left-2 z-20 bg-zinc-900/90 backdrop-blur-md border border-[#FFB800]/40 px-3.5 py-1.5 rounded-full shadow-lg flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span class="text-xs font-bold text-white tracking-wide">🔥 Sıcak & Taze</span>
        </div>

        <div class="absolute bottom-4 -right-2 z-20 bg-zinc-900/90 backdrop-blur-md border border-zinc-700 px-4 py-2 rounded-xl shadow-xl flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-[#FFB800]/20 flex items-center justify-center text-[#FFB800] text-sm">
            🍝
          </div>
          <div>
            <div class="text-xs text-zinc-400">Kıvam</div>
            <div class="text-sm font-bold text-white">Al Dente Garantisi</div>
          </div>
        </div>

        <!-- The Iconic Box Art Card -->
        <div class="relative w-full max-w-[420px] aspect-square rounded-3xl bg-gradient-to-b from-[#1C1C24] via-[#14141A] to-[#0E0E12] border-2 border-[rgba(255,184,0,0.3)] shadow-2xl p-6 flex flex-col items-center justify-center overflow-hidden group">
          <!-- Ambient backlight inside box card -->
          <div class="absolute inset-0 bg-radial from-[#FFB800]/20 via-transparent to-transparent opacity-60 group-hover:opacity-90 transition-opacity"></div>

          <!-- Rising Steam SVGs -->
          <div class="absolute top-12 z-10 flex gap-6 pointer-events-none">
            <svg class="w-8 h-16 text-zinc-400 animate-steam-1" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 55 C 6 45, 18 35, 12 25 C 6 15, 18 5, 12 0" />
            </svg>
            <svg class="w-8 h-16 text-zinc-300 animate-steam-2" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 55 C 18 45, 6 35, 12 25 C 18 15, 6 5, 12 0" />
            </svg>
            <svg class="w-8 h-16 text-zinc-400 animate-steam-3" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 55 C 8 45, 16 35, 12 25 C 8 15, 16 5, 12 0" />
            </svg>
          </div>

          <!-- Isometric Golden Takeout Box Graphic -->
          <div class="relative z-10 w-64 h-64 flex items-center justify-center transform group-hover:scale-105 transition-transform duration-500">
            <svg viewBox="0 0 240 240" class="w-full h-full drop-shadow-2xl">
              <defs>
                <linearGradient id="boxFront" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFB800" />
                  <stop offset="100%" stop-color="#D97706" />
                </linearGradient>
                <linearGradient id="boxSide" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#B45309" />
                  <stop offset="100%" stop-color="#78350F" />
                </linearGradient>
                <linearGradient id="pastaGlow" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#FFFBEB" />
                  <stop offset="100%" stop-color="#FDE68A" />
                </linearGradient>
              </defs>

              <!-- Shadows -->
              <ellipse cx="120" cy="210" rx="75" ry="18" fill="rgba(0,0,0,0.5)" />

              <!-- Box Lower Body -->
              <polygon points="60,110 180,110 160,200 80,200" fill="url(#boxFront)" />
              <polygon points="180,110 200,95 180,185 160,200" fill="url(#boxSide)" opacity="0.85" />

              <!-- Brand Logo on Box -->
              <rect x="95" y="135" width="50" height="40" rx="6" fill="#0E0E10" opacity="0.9" />
              <text x="120" y="152" fill="#FFB800" font-size="8" font-weight="900" text-anchor="middle" font-family="sans-serif">KUTUDA</text>
              <text x="120" y="165" fill="#FFFFFF" font-size="8" font-weight="900" text-anchor="middle" font-family="sans-serif">MAKARNA</text>

              <!-- Box Flaps Open (Left & Right) -->
              <polygon points="60,110 35,75 90,85 80,110" fill="#F59E0B" />
              <polygon points="180,110 205,75 150,85 160,110" fill="#D97706" />

              <!-- Fresh Pasta Noodles & Sauce Overflow -->
              <path d="M 75 110 Q 120 70 165 110 Q 140 60 100 85 Z" fill="url(#pastaGlow)" />
              
              <!-- Sauce Droplets & Swirls -->
              <path d="M 85 95 Q 120 65 155 95" stroke="#DC2626" stroke-width="6" stroke-linecap="round" fill="none" />
              <path d="M 95 105 Q 120 80 145 105" stroke="#EA580C" stroke-width="5" stroke-linecap="round" fill="none" />
              <circle cx="118" cy="88" r="4" fill="#16A34A" /> <!-- Basil leaf -->
              <circle cx="132" cy="94" r="3" fill="#16A34A" /> <!-- Basil leaf -->

              <!-- Fork picking pasta -->
              <g transform="translate(140, 35) rotate(25)">
                <rect x="0" y="0" width="8" height="60" rx="3" fill="#E4E4E7" />
                <path d="M-6 0 L14 0 L10 20 L-2 20 Z" fill="#E4E4E7" />
                <!-- Fork prongs -->
                <line x1="-3" y1="0" x2="-3" y2="-15" stroke="#D4D4D8" stroke-width="2.5" stroke-linecap="round" />
                <line x1="1" y1="0" x2="1" y2="-18" stroke="#D4D4D8" stroke-width="2.5" stroke-linecap="round" />
                <line x1="5" y1="0" x2="5" y2="-18" stroke="#D4D4D8" stroke-width="2.5" stroke-linecap="round" />
                <line x1="9" y1="0" x2="9" y2="-15" stroke="#D4D4D8" stroke-width="2.5" stroke-linecap="round" />
              </g>
            </svg>
          </div>

          <div class="relative z-10 mt-3 text-center">
            <span class="text-xs uppercase tracking-widest text-[#FFB800] font-bold">Kutunun İçinde Lezzet Var</span>
            <p class="text-xs text-zinc-400">Isı yalıtımlı özel kutusunda 30 dakika sıcacık kalır.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
