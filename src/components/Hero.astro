---
import { branches, getAllCities } from '../data/branches';

const totalBranches = branches.length;
const totalCities = getAllCities().length;

// Configurable site metrics (easy CMS / admin panel integration)
const siteStats = {
  branchesText: `${totalBranches}+ Şube & Kiosk`,
  citiesText: `Türkiye'nin ${totalCities} Şehrinde`,
  guestsText: '50.000+ Misafir',
  ratingText: '4.9/5'
};
---

<section id="hero-section" class="relative min-h-[85vh] sm:min-h-screen flex items-center justify-center overflow-hidden bg-[#0A0C10] text-white w-full">
  
  <!-- Full-Screen Authentic Background Image -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img
      src="/images/kutuda-makarna-hero-fork-pull.jpg"
      alt="Kutuda Makarna taze sıcak dumanı tüten makarna ve parmesan peyniri"
      class="w-full h-full object-cover object-center scale-105 animate-subtle-zoom opacity-45 brightness-90 contrast-110"
      loading="eager"
    />
    <!-- Deep Cinematic Vignette & Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0A0C10] via-[#0A0C10]/60 to-[#0A0C10]/85"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[#0A0C10]/50 to-[#0A0C10]/95"></div>
  </div>

  <!-- Warm Amber Ambient Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] sm:w-[700px] h-[350px] sm:h-[450px] bg-[#FFB800]/12 rounded-full blur-[140px] pointer-events-none"></div>

  <!-- Content Container (Fully Responsive & Overflow-Safe) -->
  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 text-center flex flex-col items-center justify-center">
    
    <!-- Big Headline (Responsive Typography) -->
    <h1 class="text-3xl xs:text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[1.08] sm:leading-[0.98] uppercase font-sans text-stone-100 max-w-4xl break-words">
      MAKARNA SADECE<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#FFB800] via-[#F59E0B] to-[#D97706]">
        BİR YEMEK DEĞİL.
      </span>
    </h1>

    <!-- Sub Headline -->
    <p class="mt-4 sm:mt-6 text-base sm:text-xl md:text-2xl text-stone-300 font-normal leading-relaxed max-w-2xl px-2">
      İyi makarna, iyi sos ve iyi bir hikâye.
      <span class="block text-xs sm:text-base text-stone-400 mt-2 font-light">
        Durum buğdayı irmiğiyle açılan taze hamur ve sipariş anında tavada bağlanan İtalyan sosları.
      </span>
    </p>

    <!-- CTAs: "Menüyü Keşfet" & "En Yakın Şubeyi Bul" -->
    <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 w-full sm:w-auto px-4 sm:px-0">
      <a
        href="#menu"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 sm:px-8 py-3.5 sm:py-4 rounded-2xl bg-[#FFB800] hover:bg-[#F59E0B] text-[#1C1917] font-black text-sm uppercase tracking-wider shadow-xl shadow-amber-500/20 transition-all hover:scale-105 active:scale-95 group cursor-pointer"
      >
        <span>MENÜYÜ KEŞFET</span>
        <span class="w-6 h-6 rounded-full bg-[#1C1917] text-[#FFB800] flex items-center justify-center text-xs group-hover:translate-x-0.5 transition-transform">
          ↓
        </span>
      </a>

      <a
        href="#subeler"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 sm:px-8 py-3.5 sm:py-4 rounded-2xl bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/25 text-white font-bold text-sm transition-all hover:border-[#FFB800] active:scale-95 shadow-lg cursor-pointer"
      >
        <span>📍 EN YAKIN ŞUBEYİ BUL</span>
      </a>
    </div>

    <!-- Social Proof Bar (Responsive Grid) -->
    <div class="mt-12 sm:mt-14 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-8 text-stone-300 w-full max-w-4xl">
      
      <div class="flex flex-col items-center p-2">
        <span class="text-xl sm:text-3xl font-black text-[#FFB800] font-mono">{siteStats.branchesText}</span>
        <span class="text-[11px] sm:text-xs text-stone-400 mt-0.5">Fiziksel Restoran & Kiosk</span>
      </div>

      <div class="flex flex-col items-center p-2">
        <span class="text-xl sm:text-3xl font-black text-white font-mono">{siteStats.citiesText}</span>
        <span class="text-[11px] sm:text-xs text-stone-400 mt-0.5">Büyüyen Franchise Ağı</span>
      </div>

      <div class="flex flex-col items-center p-2">
        <span class="text-xl sm:text-3xl font-black text-[#FFB800] font-mono">{siteStats.guestsText}</span>
        <span class="text-[11px] sm:text-xs text-stone-400 mt-0.5">Aylık Misafir</span>
      </div>

      <div class="flex flex-col items-center p-2">
        <div class="flex items-center gap-1 text-xl sm:text-3xl font-black text-amber-400 font-mono">
          <span>★</span>
          <span>{siteStats.ratingText}</span>
        </div>
        <span class="text-[11px] sm:text-xs text-stone-400 mt-0.5">Müşteri Memnuniyeti</span>
      </div>

    </div>

  </div>

  <!-- Scroll Down Indicator -->
  <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 hidden sm:flex flex-col items-center gap-1 text-stone-400 text-[10px] uppercase tracking-widest font-bold opacity-80">
    <span>AŞAĞI KAYDIR</span>
    <span class="animate-bounce text-[#FFB800]">↓</span>
  </div>

</section>

<style>
  @keyframes subtle-zoom {
    0% { transform: scale(1.02); }
    50% { transform: scale(1.06); }
    100% { transform: scale(1.02); }
  }
  .animate-subtle-zoom {
    animation: subtle-zoom 20s ease-in-out infinite alternate;
  }
</style>
