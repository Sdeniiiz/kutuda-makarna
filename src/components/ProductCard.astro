---
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article class="group relative bg-[#14141A] rounded-2xl border border-zinc-800/90 overflow-hidden card-hover flex flex-col justify-between p-6">
  <!-- Top Badge & Spiciness -->
  <div class="flex items-center justify-between mb-4">
    {item.badge ? (
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-[#FFB800]/15 text-[#FFB800] border border-[#FFB800]/30">
        {item.badge}
      </span>
    ) : (
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold text-zinc-400 bg-zinc-800">
        {item.categoryName}
      </span>
    )}

    <div class="flex items-center gap-1">
      {item.spicyLevel > 0 && (
        <span class="text-xs" title={`Acılık: ${item.spicyLevel}/3`}>
          {'🌶️'.repeat(item.spicyLevel)}
        </span>
      )}
      {item.isVegetarian && (
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800/60" title="Vejetaryen">
          VEG 🌱
        </span>
      )}
    </div>
  </div>

  <!-- Product Visual Representation (Stylized Box Canvas) -->
  <a href={`/menu/${item.slug}`} class="block relative w-full h-44 rounded-xl bg-gradient-to-b from-[#1E1E26] to-[#121216] border border-zinc-800 flex items-center justify-center overflow-hidden mb-5 group-hover:border-[#FFB800]/40 transition-colors">
    <div class="absolute inset-0 bg-radial from-[#FFB800]/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
    
    <!-- Stylized Plate/Box Vector -->
    <div class="relative z-10 w-28 h-28 transform group-hover:scale-110 group-hover:-rotate-2 transition-transform duration-300 flex items-center justify-center">
      <div class="w-24 h-24 rounded-2xl bg-[#FFB800]/20 border border-[#FFB800]/40 flex flex-col items-center justify-center p-3 text-center shadow-lg">
        <span class="text-3xl mb-1">
          {item.category === 'kremali' ? '🍝' : item.category === 'domatesli' ? '🍅' : item.category === 'yan-urun' ? '🍰' : '🌿'}
        </span>
        <span class="text-[9px] font-black text-[#FFB800] uppercase tracking-wider">{item.pastaType}</span>
      </div>
    </div>

    <!-- Quick Info Pill -->
    <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-black/70 backdrop-blur-sm text-[10px] text-zinc-400 font-medium">
      ⏱️ {item.prepTimeMinutes} dk
    </div>
  </a>

  <!-- Content -->
  <div class="space-y-2 flex-1">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-lg font-bold text-white group-hover:text-[#FFB800] transition-colors leading-snug">
        <a href={`/menu/${item.slug}`}>{item.name}</a>
      </h3>
    </div>
    
    <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">
      {item.shortDescription}
    </p>
  </div>

  <!-- Footer Price & CTA -->
  <div class="pt-5 mt-4 border-t border-zinc-800/80 flex items-center justify-between">
    <div>
      <span class="text-xs text-zinc-500 block">Porsiyon: {item.portionGrams}g</span>
      <span class="text-xl font-black text-white">{item.price} <span class="text-xs text-[#FFB800] font-bold">₺</span></span>
    </div>

    <a
      href={`/menu/${item.slug}`}
      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-zinc-800 hover:bg-[#FFB800] hover:text-[#0E0E10] text-zinc-200 text-xs font-bold transition-all hover:scale-105"
      aria-label={`${item.name} detaylarını gör`}
    >
      <span>İncele</span>
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </a>
  </div>
</article>
