---
import type { MenuItem } from '../data/menu';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<article class="group relative bg-white border border-stone-200/90 rounded-3xl p-5 sm:p-6 transition-all duration-300 hover:border-amber-400/70 hover:shadow-xl hover:shadow-amber-950/5 hover:-translate-y-1 flex flex-col sm:flex-row gap-5 items-start sm:items-center justify-between">
  
  <!-- Left: Authentic Food Photo (Al Dente Macaroni culinary thumbnail) -->
  <a
    href={`/menu/${item.slug}`}
    class="relative w-full sm:w-36 h-40 sm:h-36 rounded-2xl overflow-hidden shrink-0 border border-stone-200/80 shadow-sm block group/img"
  >
    <img
      src={item.image}
      alt={item.name}
      class="w-full h-full object-cover group-hover/img:scale-110 transition-transform duration-500 ease-out"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity"></div>
    
    <!-- Prep Time Pill -->
    <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded-lg bg-black/70 backdrop-blur-xs text-[10px] font-bold text-white flex items-center gap-1 border border-white/20">
      <span>⏱️</span>
      <span>{item.prepTimeMinutes} dk</span>
    </div>
  </a>

  <!-- Right: Al Dente Macaroni Food Details -->
  <div class="space-y-2.5 flex-1 min-w-0 w-full">
    
    <!-- Header with Name, Badge and Price -->
    <div class="flex items-start justify-between gap-3 flex-wrap sm:flex-nowrap">
      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-[10px] font-black uppercase tracking-wider text-[#B45309] bg-amber-100/80 border border-amber-200 px-2.5 py-0.5 rounded-full">
            {item.badge || item.categoryName}
          </span>
          {item.isVegetarian && (
            <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full border border-emerald-200">
              🌱 Vejetaryen
            </span>
          )}
          {item.spicyLevel > 0 && (
            <span class="text-xs" title={`Acılık: ${item.spicyLevel}/3`}>
              {'🌶️'.repeat(item.spicyLevel)}
            </span>
          )}
        </div>

        <h3 class="text-lg sm:text-xl font-black text-[#1C1917] group-hover:text-[#D97706] transition-colors leading-snug">
          <a href={`/menu/${item.slug}`}>{item.name}</a>
        </h3>
      </div>

      <!-- Price Badge (Al Dente Style Accent) -->
      <div class="text-right shrink-0">
        <span class="text-2xl font-black text-[#1C1917] font-mono group-hover:text-[#D97706] transition-colors">
          {item.price} <span class="text-sm font-bold text-[#D97706]">₺</span>
        </span>
      </div>
    </div>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-stone-600 line-clamp-2 leading-relaxed">
      {item.shortDescription}
    </p>

    <!-- Al Dente Style Nutritional & Specs Line -->
    <div class="pt-2 border-t border-stone-100 flex items-center justify-between gap-2 text-[11px] text-stone-500 font-medium flex-wrap">
      <span class="flex items-center gap-1.5">
        <strong class="text-stone-700">Hamur:</strong> {item.pastaType}
      </span>
      <span class="flex items-center gap-1.5">
        <strong class="text-stone-700">Porsiyon:</strong> {item.portionGrams}g • {item.calories} kcal
      </span>
      <a
        href={`/menu/${item.slug}`}
        class="inline-flex items-center gap-1 font-black text-xs text-[#D97706] hover:underline ml-auto"
      >
        <span>İncele</span>
        <span>→</span>
      </a>
    </div>

  </div>

</article>
