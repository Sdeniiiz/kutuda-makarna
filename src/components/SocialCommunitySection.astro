---
const socialPosts = [
  {
    author: '@deniz_gurme',
    caption: 'Atakum sahilinde gün batımına karşı kremalı mantarlı penne keyfi 🔥',
    image: '/images/kutuda-makarna-sahil-deneyimi.jpg',
    likes: '1.4K'
  },
  {
    author: '@makarna_asigi',
    caption: 'Buharı üzerinde sıcacık kutu! Peynir uzaması gerçekten şaka değil 🧀',
    image: '/images/kutuda-makarna-fork-lifted.jpg',
    likes: '2.8K'
  },
  {
    author: '@ege_lezzetleri',
    caption: 'Alsancak şubesinden gel-al aldım, Kordon çimlerinde arkadaşlarımla ziyafet 🌿',
    image: '/images/pasta/pesto.jpg',
    likes: '940'
  },
  {
    author: '@istanbul.foodie',
    caption: 'Kadıköy Moda sokaklarında kutuda taze sıcak makarna konsepti harika olmuş!',
    image: '/images/restoran-atmosfer.jpg',
    likes: '3.1K'
  }
];
---

<section id="sosyal-medya" class="py-20 sm:py-32 bg-[#FBF9F5] border-b border-stone-200/80 w-full overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-12 sm:mb-14 text-center md:text-left">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[#B45309] text-xs font-black uppercase tracking-widest">
          <!-- Vector Instagram Icon in Badge -->
          <svg class="w-3.5 h-3.5 fill-current text-[#E4405F]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>INSTAGRAM TOPLULUĞU</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-[#1C1917] tracking-tight uppercase font-sans break-words">
          #KUTUDAMAKARNA
        </h2>
        <p class="text-sm sm:text-base text-stone-600">
          Kutunu paylaş, hikayene ekle, <span class="font-bold text-[#D97706]">@kutudamakarna</span> ile sayfamızda yerini al!
        </p>
      </div>

      <!-- Action Button with Official SVG Instagram Icon -->
      <a
        href="https://instagram.com/kutudamakarna"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl bg-[#1C1917] hover:bg-[#D97706] text-white font-bold text-xs uppercase tracking-wider transition-all hover:scale-105 active:scale-95 shadow-md shrink-0"
      >
        <svg class="w-4 h-4 fill-current text-[#E4405F]" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>Bizi Takip Et: @kutudamakarna</span>
      </a>
    </div>

    <!-- Social Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {socialPosts.map((post) => (
        <a
          href="https://instagram.com/kutudamakarna"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-stone-200 aspect-[4/5] bg-stone-900 block w-full"
        >
          <img
            src={post.image}
            alt={post.caption}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-106"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>

          <!-- Top Meta -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-white text-xs font-bold">
            <span class="bg-black/60 backdrop-blur-xs px-2.5 py-1 rounded-full">{post.author}</span>
            <span class="flex items-center gap-1 text-rose-400">♥ {post.likes}</span>
          </div>

          <!-- Bottom Caption -->
          <div class="absolute bottom-4 left-4 right-4 text-white space-y-1">
            <p class="text-xs text-stone-200 line-clamp-2 leading-relaxed">
              {post.caption}
            </p>
            <span class="text-[10px] text-amber-400 font-bold uppercase tracking-wider block pt-1">
              Instagram'da Gör →
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
