---
---

<section id="online-siparis" class="py-20 sm:py-28 bg-[#1C1917] text-white relative overflow-hidden border-b border-stone-800">
  <!-- Warm glow in background -->
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#FFB800]/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Text & Buttons Column -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-amber-400 text-xs font-black uppercase tracking-widest">
          <span>🛵</span>
          <span>KAPINA KADAR SICAK TESLİMAT</span>
        </div>

        <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-white tracking-tight uppercase font-sans">
          MAKARNAYI EVE Mİ ALALIM?
        </h2>

        <p class="text-xl sm:text-2xl text-stone-300 font-normal leading-relaxed">
          Canın makarna çektiyse bekleme.
          <span class="block text-sm sm:text-base text-stone-400 mt-2 font-light">
            Özel termal kutumuz buharı dışarı atarken sosun ve makarnanın ısısını 30 dakika boyunca korur. Tavadan çıktığı tazelikte kapında.
          </span>
        </p>

        <!-- CTA Buttons (Online Sipariş Ver & Şubeden Gel Al) -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <button
            type="button"
            data-open-online-order-modal
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-[#FFB800] hover:bg-[#F59E0B] text-[#1C1917] font-black text-sm uppercase tracking-wider shadow-xl shadow-amber-500/15 transition-all hover:scale-105 active:scale-95 cursor-pointer"
          >
            <span>Online Sipariş Ver</span>
            <span>🛵</span>
          </button>

          <button
            type="button"
            data-open-online-order-modal
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm uppercase tracking-wider transition-all hover:scale-105 active:scale-95 cursor-pointer"
          >
            <span>Şubeden Gel Al (3-5 Dk)</span>
            <span>⚡</span>
          </button>
        </div>

        <!-- Integrated Platforms Logos Strip -->
        <div class="pt-6 border-t border-white/10 flex items-center justify-center lg:justify-start gap-6 text-xs text-stone-400">
          <span class="font-bold">Sipariş Kanalları:</span>
          <span class="text-stone-300 font-semibold">Yemeksepeti</span>
          <span>•</span>
          <span class="text-stone-300 font-semibold">GetirYemek</span>
          <span>•</span>
          <span class="text-stone-300 font-semibold">Trendyol Yemek</span>
        </div>

      </div>

      <!-- Right Visual Column (Thermal Box Feature) -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full max-w-md aspect-square rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-stone-900 group">
          <img
            src="/images/kutuda-makarna-kremali-kutu.jpg"
            alt="Kutuda Makarna sıcak teslimat kutusu"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>

          <!-- Thermal Badge Pill -->
          <div class="absolute bottom-5 left-5 right-5 p-4 rounded-2xl bg-black/70 backdrop-blur-md border border-white/20 text-center">
            <span class="text-xs font-black uppercase text-[#FFB800]">30 DAKİKA TERMAL KORUMA</span>
            <p class="text-xs text-stone-300 mt-1">Özel hava kanallı gıda dostu termo-kutu</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
