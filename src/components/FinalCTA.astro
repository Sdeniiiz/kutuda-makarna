---
---

<section id="final-cta-section" class="py-28 lg:py-36 bg-gradient-to-t from-[#0A0A0D] via-[#121218] to-[#0A0A0D] border-t border-zinc-900 relative overflow-hidden">
  <!-- Glowing Center Spot -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#FFB800]/10 rounded-full blur-[140px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
    
    <!-- Final Interactive Box Vector (Closed -> Opens -> Steam) -->
    <div class="relative w-28 h-28 mx-auto flex items-center justify-center group cursor-pointer" id="final-box-trigger">
      <!-- Rising Steam -->
      <div class="absolute -top-6 flex gap-3 pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity">
        <svg class="w-6 h-12 text-zinc-400 animate-steam-1" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 55 C 6 45, 18 35, 12 25 C 6 15, 18 5, 12 0" />
        </svg>
        <svg class="w-6 h-12 text-zinc-300 animate-steam-2" viewBox="0 0 24 60" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 55 C 18 45, 6 35, 12 25 C 18 15, 6 5, 12 0" />
        </svg>
      </div>

      <!-- Golden Box Icon Container -->
      <div class="w-24 h-24 rounded-3xl bg-gradient-to-br from-[#FFB800] to-[#D97706] flex items-center justify-center text-[#0A0A0D] font-black text-4xl shadow-2xl shadow-[#FFB800]/30 transform group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300">
        📦
      </div>
    </div>

    <!-- Final Punchy Typography -->
    <div class="space-y-3">
      <span class="text-xs font-black uppercase tracking-widest text-[#FFB800]">LEZZET SENİ BEKLİYOR</span>
      <h2 class="text-4xl sm:text-6xl font-black text-white tracking-tight font-sans leading-tight">
        ACIKTIYSAN<br />
        <span class="text-[#FFB800]">KUTUYU BUL.</span>
      </h2>
      <p class="text-zinc-300 text-base sm:text-lg max-w-lg mx-auto font-normal leading-relaxed pt-1">
        Taze makarna hamuru ve sıcacık soslar hazır. Kutunu seç ya da en yakın şubemize uğra!
      </p>
    </div>

    <!-- Triple Action CTAs -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/subeler"
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#FFB800] text-[#0A0A0D] font-black text-base hover:bg-[#F59E0B] shadow-xl shadow-[#FFB800]/25 transition-all hover:scale-105 active:scale-95"
      >
        EN YAKIN ŞUBE
      </a>

      <a
        href="/menu"
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-[#14141A] border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-base transition-all hover:bg-zinc-800"
      >
        MENÜYÜ GÖR
      </a>

      <a
        href="tel:+903625000101"
        class="w-full sm:w-auto px-8 py-4 rounded-xl border border-zinc-700 hover:border-[#FFB800] text-zinc-300 hover:text-white font-bold text-base transition-all hover:bg-zinc-800/80 font-mono"
      >
        📞 SİPARİŞ VER
      </a>
    </div>

  </div>
</section>
