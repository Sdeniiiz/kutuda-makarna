---
import { menuItems } from '../data/menu';

// 4 signature hero products
const heroProducts = menuItems.filter(item => 
  ['kremali-mantarli-makarna', 'bolonez-makarna', 'pesto-makarna', 'acili-arrabbiata-makarna'].includes(item.slug)
);
---

<section id="products-showcase" class="py-24 lg:py-32 bg-[#0A0A0D] border-t border-zinc-900 relative overflow-hidden">
  <!-- Subtle Backlight -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#FFB800]/5 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-black uppercase tracking-widest">
          <span>🍝 İMZA LEZZETLER</span>
        </div>
        <h2 class="text-4xl sm:text-6xl font-black text-white tracking-tight font-sans">
          ŞİMDİ <span class="text-[#FFB800]">ZOR KISIM.</span>
        </h2>
        <p class="text-zinc-400 text-lg sm:text-xl font-normal">
          Hangisini seçeceksin? Tavadan yeni inen 4 imza kutumuz.
        </p>
      </div>

      <a
        href="/menu"
        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-xl bg-zinc-900 border border-zinc-700 hover:border-[#FFB800] text-white font-bold text-sm transition-all hover:bg-zinc-800 shrink-0 group"
      >
        <span>Tüm Menüyü İncele</span>
        <span class="group-hover:translate-x-1 transition-transform text-[#FFB800]">→</span>
      </a>
    </div>

    <!-- Products Grid (Photo-First Minimal Dark Luxury) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {heroProducts.map((p) => (
        <article class="group relative bg-[#14141A] rounded-3xl border border-zinc-800/90 overflow-hidden p-6 flex flex-col justify-between transition-all duration-300 hover:border-[#FFB800]/40 hover:shadow-2xl hover:shadow-[#FFB800]/10">
          
          <!-- Top Badges -->
          <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] font-black uppercase tracking-widest text-[#FFB800] px-3 py-1 rounded-full bg-[#FFB800]/15 border border-[#FFB800]/30">
              {p.badge || p.categoryName}
            </span>
            <span class="text-xs text-zinc-500 font-mono">⏱️ {p.prepTimeMinutes} dk</span>
          </div>

          <!-- Hero Food Plate Canvas -->
          <a
            href={`/menu/${p.slug}`}
            class="block relative w-full aspect-square rounded-2xl bg-gradient-to-b from-[#1C1C24] to-[#101015] border border-zinc-800 flex items-center justify-center overflow-hidden mb-6 group-hover:border-[#FFB800]/50 transition-colors"
          >
            <!-- Ambient Glow on Hover -->
            <div class="absolute inset-0 bg-radial from-[#FFB800]/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Stylized Dish Art -->
            <div class="relative z-10 w-36 h-36 flex flex-col items-center justify-center transform transition-transform duration-300 ease-out group-hover:scale-[1.03] group-hover:rotate-[1deg]">
              <div class="w-28 h-28 rounded-3xl bg-[#FFB800]/20 border border-[#FFB800]/40 flex flex-col items-center justify-center p-3 text-center shadow-xl">
                <span class="text-4xl mb-1">
                  {p.category === 'kremali' ? '🍝' : p.category === 'domatesli' ? '🍅' : '🌿'}
                </span>
                <span class="text-[9px] font-black text-[#FFB800] uppercase tracking-wider">{p.pastaType}</span>
              </div>
            </div>

            <!-- Price Tag Inside Plate -->
            <div class="absolute bottom-3 right-3 px-3 py-1 rounded-lg bg-[#0A0A0D]/90 backdrop-blur-md border border-zinc-700 text-sm font-black text-white">
              {p.price} <span class="text-xs text-[#FFB800] font-bold">₺</span>
            </div>
          </a>

          <!-- Details (1-3px Title Slide on Hover) -->
          <div class="space-y-2 flex-1">
            <h3 class="text-xl font-bold text-white group-hover:text-[#FFB800] group-hover:-translate-y-0.5 transition-transform duration-200">
              <a href={`/menu/${p.slug}`}>{p.name}</a>
            </h3>
            <p class="text-xs text-zinc-400 line-clamp-2 leading-relaxed">
              {p.shortDescription}
            </p>
          </div>

          <!-- Bottom CTA -->
          <div class="pt-6 mt-6 border-t border-zinc-800/80 flex items-center justify-between">
            <span class="text-xs text-zinc-500 font-mono">{p.portionGrams}g</span>
            <a
              href={`/menu/${p.slug}`}
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-zinc-800 hover:bg-[#FFB800] hover:text-[#0A0A0D] text-zinc-200 text-xs font-bold transition-all hover:scale-105"
            >
              <span>Kutuyu Gör</span>
              <span>→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
