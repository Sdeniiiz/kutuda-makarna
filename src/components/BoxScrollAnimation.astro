---
---

<section id="pasta-box-experience" class="relative bg-[#0A0A0C] border-y border-[rgba(255,184,0,0.15)] py-20 lg:py-28 overflow-hidden">
  <!-- Glow backdrop -->
  <div class="absolute inset-0 bg-radial from-[#FFB800]/5 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-bold uppercase tracking-wider mb-4">
        <span>📦 Marka Deneyimi</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-sans">
        KUTUYA DOLAN <span class="text-[#FFB800]">TAZE LEZZET</span>
      </h2>
      <p class="text-zinc-400 mt-3 text-sm sm:text-base">
        Aşağı kaydır ve makarnanın kutuda nasıl bir lezzet şölenine dönüştüğünü adım adım izle.
      </p>
    </div>

    <!-- Pinned Scroll Arena -->
    <div id="scroll-pin-wrapper" class="relative flex flex-col lg:flex-row items-center justify-center gap-12 min-h-[550px]">
      
      <!-- Interactive SVG Pasta Box Container -->
      <div class="relative w-[300px] sm:w-[380px] h-[340px] sm:h-[420px] flex items-center justify-center">
        
        <!-- Glowing background disc -->
        <div class="absolute w-72 h-72 rounded-full bg-[#FFB800]/15 blur-2xl"></div>

        <!-- The SVG Box with layers -->
        <svg id="box-master-svg" viewBox="0 0 320 340" class="w-full h-full relative z-10 drop-shadow-2xl overflow-visible">
          <defs>
            <linearGradient id="boxOuterGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFB800" />
              <stop offset="100%" stop-color="#D97706" />
            </linearGradient>
            <linearGradient id="boxInnerDark" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#18181B" />
              <stop offset="100%" stop-color="#27272A" />
            </linearGradient>
            <linearGradient id="sauceGold" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#F59E0B" />
              <stop offset="100%" stop-color="#DC2626" />
            </linearGradient>
            <linearGradient id="pastaYellow" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FEF08A" />
              <stop offset="100%" stop-color="#FACC15" />
            </linearGradient>
          </defs>

          <!-- Shadow -->
          <ellipse cx="160" cy="305" rx="100" ry="20" fill="rgba(0,0,0,0.6)" />

          <!-- Back Inside Of Box (Visible when empty) -->
          <polygon points="70,160 250,160 220,290 100,290" fill="url(#boxInnerDark)" />

          <!-- LAYER 1: First Pasta Layer (Falls from top into box) -->
          <g id="layer-pasta-1" class="transform transition-transform" style="transform: translateY(-80px); opacity: 0;">
            <!-- Pasta strands inside bottom -->
            <path d="M 105 260 Q 130 240 160 260 Q 190 280 215 255 Q 180 240 140 250 Z" fill="url(#pastaYellow)" />
            <path d="M 95 245 Q 140 225 185 245 Q 215 260 225 240 Q 160 230 110 240 Z" fill="#FDE047" />
          </g>

          <!-- LAYER 2: Half Full Pasta & Sauce Emulsion -->
          <g id="layer-pasta-2" class="transform transition-transform" style="transform: translateY(-60px); opacity: 0;">
            <!-- Creamy rich sauce fill -->
            <path d="M 85 220 Q 160 195 235 220 L 225 260 L 95 260 Z" fill="url(#sauceGold)" opacity="0.95" />
            <!-- Pasta clusters -->
            <path d="M 90 205 Q 120 180 160 200 Q 200 220 230 195 Q 170 175 110 195 Z" fill="#FEF08A" />
            <circle cx="130" cy="210" r="7" fill="#713F12" /> <!-- Sautéed Mushroom -->
            <circle cx="185" cy="205" r="8" fill="#713F12" /> <!-- Sautéed Mushroom -->
          </g>

          <!-- LAYER 3: Completely Full Overflowing Pasta -->
          <g id="layer-pasta-3" class="transform transition-transform" style="transform: translateY(-40px); opacity: 0;">
            <!-- Top mound of pasta -->
            <path d="M 68 160 Q 160 115 252 160 Q 220 130 160 130 Q 100 130 68 160 Z" fill="url(#pastaYellow)" />
            <!-- Sauce dribble over mound -->
            <path d="M 90 145 Q 160 125 230 148" stroke="#DC2626" stroke-width="7" stroke-linecap="round" fill="none" />
            <path d="M 110 155 Q 160 138 210 158" stroke="#F59E0B" stroke-width="5" stroke-linecap="round" fill="none" />
            <!-- Fresh garnish: Basil & Cherry Tomato -->
            <circle cx="145" cy="135" r="9" fill="#DC2626" /> <!-- Cherry Tomato -->
            <path d="M 170 130 C 160 120, 185 115, 180 135 Z" fill="#16A34A" /> <!-- Fresh Basil -->
            <path d="M 135 125 C 130 115, 150 110, 145 130 Z" fill="#22C55E" /> <!-- Small Basil -->
            <!-- Parmesan flakes -->
            <rect x="120" y="140" width="6" height="4" rx="1" fill="#FFFFFF" transform="rotate(15)" />
            <rect x="190" y="142" width="7" height="3" rx="1" fill="#FFFFFF" transform="rotate(-25)" />
            <rect x="160" y="145" width="5" height="5" rx="1" fill="#FFFFFF" transform="rotate(45)" />
          </g>

          <!-- Box Front & Sides (Cuts through pasta inside) -->
          <polygon points="70,160 250,160 220,290 100,290" fill="none" stroke="rgba(255,184,0,0.3)" stroke-width="2" />
          <polygon points="70,160 250,160 220,290 100,290" fill="url(#boxOuterGrad)" opacity="0.95" />
          <polygon points="250,160 275,145 245,275 220,290" fill="#92400E" />

          <!-- Front Logo on Box Body -->
          <rect x="120" y="200" width="80" height="50" rx="8" fill="#0E0E10" opacity="0.95" />
          <text x="160" y="222" fill="#FFB800" font-size="11" font-weight="900" text-anchor="middle" font-family="sans-serif">KUTUDA</text>
          <text x="160" y="238" fill="#FFFFFF" font-size="11" font-weight="900" text-anchor="middle" font-family="sans-serif">MAKARNA</text>

          <!-- Box Left Flap -->
          <polygon id="flap-left" points="70,160 30,110 110,125 100,160" fill="#F59E0B" />
          <!-- Box Right Flap -->
          <polygon id="flap-right" points="250,160 290,110 210,125 220,160" fill="#D97706" />

          <!-- Rising Steam Paths (Shows at 100%) -->
          <g id="layer-steam" style="opacity: 0;">
            <path class="animate-steam-1" d="M 130 110 Q 110 70 130 30" stroke="rgba(255,255,255,0.7)" stroke-width="3" stroke-linecap="round" fill="none" />
            <path class="animate-steam-2" d="M 160 100 Q 180 60 160 20" stroke="rgba(255,255,255,0.8)" stroke-width="3.5" stroke-linecap="round" fill="none" />
            <path class="animate-steam-3" d="M 190 110 Q 170 70 190 30" stroke="rgba(255,255,255,0.7)" stroke-width="3" stroke-linecap="round" fill="none" />
          </g>

          <!-- Fork Landing into Box (Shows at 100%) -->
          <g id="layer-fork" class="transform transition-transform" style="transform: translate(25px, -60px) rotate(15deg); opacity: 0;">
            <rect x="180" y="10" width="10" height="90" rx="4" fill="#E4E4E7" />
            <path d="M 172 90 L 198 90 L 194 125 L 176 125 Z" fill="#E4E4E7" />
            <line x1="175" y1="125" x2="175" y2="150" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="181" y1="125" x2="181" y2="155" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="189" y1="125" x2="189" y2="155" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="195" y1="125" x2="195" y2="150" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
          </g>
        </svg>
      </div>

      <!-- Live Stage Status Tracker & Content Callout -->
      <div class="w-full lg:w-[420px] bg-[#141418] border border-zinc-800 rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl relative">
        <!-- Progress Bar Indicator -->
        <div>
          <div class="flex items-center justify-between text-xs font-bold text-zinc-400 mb-2">
            <span id="box-progress-label">DOLDURMA AŞAMASI</span>
            <span id="box-progress-percent" class="text-[#FFB800] font-mono text-sm">0%</span>
          </div>
          <div class="w-full h-2 bg-zinc-800 rounded-full overflow-hidden">
            <div id="box-progress-bar" class="h-full bg-gradient-to-r from-[#FFB800] to-[#F59E0B] w-0 transition-all duration-150"></div>
          </div>
        </div>

        <!-- Dynamic Stage Cards -->
        <div class="space-y-4 min-h-[140px]">
          <div id="stage-text-0" class="stage-card">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Adım 1 / 4</span>
            <h3 class="text-xl font-bold text-white mt-1">Isı Yalıtımlı Kutu Hazır</h3>
            <p class="text-zinc-400 text-sm mt-1">Özel geometrili kutumuz, makarnanın nemini ve sıcaklığını 30 dakika boyunca ideal dengede korumak üzere açılıyor.</p>
          </div>

          <div id="stage-text-1" class="stage-card hidden">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Adım 2 / 4</span>
            <h3 class="text-xl font-bold text-white mt-1">Al Dente Taze Makarna İniyor</h3>
            <p class="text-zinc-400 text-sm mt-1">Kaynar suda tam kıvamında 2 dakika haşlanan durum buğdayı makarnası sıcak sıcak kutuya dolmaya başlıyor.</p>
          </div>

          <div id="stage-text-2" class="stage-card hidden">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Adım 3 / 4</span>
            <h3 class="text-xl font-bold text-white mt-1">Tavadaki Sıcak Sos & Malzemeler</h3>
            <p class="text-zinc-400 text-sm mt-1">Taze sotelenmiş mantarlar ve ipeksi krema, makarnanın her kıvrımına eşit şekilde bağlanıyor.</p>
          </div>

          <div id="stage-text-3" class="stage-card hidden">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">Tamamlandı! 🔥</span>
            <h3 class="text-2xl font-black text-white mt-1">KUTU DOLDU. ŞİMDİ SIRA SENDE!</h3>
            <p class="text-zinc-300 text-sm mt-1">Parmesan serpildi, buharı tütüyor. Kutunu kap ve lezzetin tadını çıkar.</p>
            
            <div class="pt-3">
              <a
                href="/menu"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#FFB800] text-[#0E0E10] font-black text-sm hover:bg-[#F59E0B] shadow-lg shadow-[#FFB800]/25 transition-transform hover:scale-105"
              >
                <span>Hemen Kutunu Seç</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Manual Step Navigation for Accessibility & Mobile Touch -->
        <div class="pt-4 border-t border-zinc-800 flex items-center justify-between">
          <span class="text-xs text-zinc-500">Scroll veya butonlarla ilerle:</span>
          <div class="flex items-center gap-2">
            <button id="btn-step-prev" class="px-2.5 py-1 text-xs rounded bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors" aria-label="Önceki Aşama">‹ Geri</button>
            <button id="btn-step-next" class="px-2.5 py-1 text-xs rounded bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors" aria-label="Sonraki Aşama">İleri ›</button>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- GSAP & ScrollTrigger Interactive Script -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Check reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const pinWrapper = document.getElementById('scroll-pin-wrapper');
  const layer1 = document.getElementById('layer-pasta-1');
  const layer2 = document.getElementById('layer-pasta-2');
  const layer3 = document.getElementById('layer-pasta-3');
  const layerSteam = document.getElementById('layer-steam');
  const layerFork = document.getElementById('layer-fork');
  const flapLeft = document.getElementById('flap-left');
  const flapRight = document.getElementById('flap-right');

  const progressBar = document.getElementById('box-progress-bar');
  const progressPercent = document.getElementById('box-progress-percent');

  const stage0 = document.getElementById('stage-text-0');
  const stage1 = document.getElementById('stage-text-1');
  const stage2 = document.getElementById('stage-text-2');
  const stage3 = document.getElementById('stage-text-3');

  function updateStageUI(progress: number) {
    const percent = Math.min(100, Math.max(0, Math.round(progress * 100)));
    if (progressBar) progressBar.style.width = `${percent}%`;
    if (progressPercent) progressPercent.innerText = `${percent}%`;

    const stages = [stage0, stage1, stage2, stage3];
    stages.forEach(s => s?.classList.add('hidden'));

    if (progress < 0.25) {
      stage0?.classList.remove('hidden');
    } else if (progress < 0.60) {
      stage1?.classList.remove('hidden');
    } else if (progress < 0.85) {
      stage2?.classList.remove('hidden');
    } else {
      stage3?.classList.remove('hidden');
    }
  }

  if (prefersReducedMotion) {
    // If reduced motion is requested, show full box immediately without scroll pinning
    if (layer1) { layer1.style.opacity = '1'; layer1.style.transform = 'translateY(0)'; }
    if (layer2) { layer2.style.opacity = '1'; layer2.style.transform = 'translateY(0)'; }
    if (layer3) { layer3.style.opacity = '1'; layer3.style.transform = 'translateY(0)'; }
    if (layerSteam) layerSteam.style.opacity = '1';
    if (layerFork) { layerFork.style.opacity = '1'; layerFork.style.transform = 'translate(0, 0) rotate(10deg)'; }
    updateStageUI(1);
  } else if (pinWrapper) {
    // Create Timeline linked with ScrollTrigger
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#pasta-box-experience',
        start: 'top top+=80',
        end: '+=1200',
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
        onUpdate: (self) => {
          updateStageUI(self.progress);
        }
      }
    });

    // 0% -> 25%: Flaps open, Layer 1 descends
    tl.to(flapLeft, { rotation: -15, transformOrigin: 'bottom right', duration: 1 }, 0)
      .to(flapRight, { rotation: 15, transformOrigin: 'bottom left', duration: 1 }, 0)
      .to(layer1, { y: 0, opacity: 1, duration: 1.5, ease: 'power2.out' }, 0.5)

    // 25% -> 60%: Layer 2 (sauce & mushrooms) fills in
      .to(layer2, { y: 0, opacity: 1, duration: 1.8, ease: 'power2.out' }, 1.8)

    // 60% -> 85%: Layer 3 (garnish & full mound) fills in
      .to(layer3, { y: 0, opacity: 1, duration: 2, ease: 'back.out(1.2)' }, 3.2)

    // 85% -> 100%: Steam appears & fork enters
      .to(layerSteam, { opacity: 1, duration: 1 }, 4.5)
      .to(layerFork, { x: 0, y: 0, rotation: 10, opacity: 1, duration: 1.2, ease: 'power2.out' }, 4.6);

    // Interactive step buttons
    let currentStep = 0;
    const stepProgress = [0, 0.35, 0.70, 1.0];

    document.getElementById('btn-step-next')?.addEventListener('click', () => {
      currentStep = Math.min(3, currentStep + 1);
      tl.progress(stepProgress[currentStep]);
      updateStageUI(stepProgress[currentStep]);
    });

    document.getElementById('btn-step-prev')?.addEventListener('click', () => {
      currentStep = Math.max(0, currentStep - 1);
      tl.progress(stepProgress[currentStep]);
      updateStageUI(stepProgress[currentStep]);
    });
  }
</script>
