---
---

<section id="pasta-box-experience" class="relative bg-[#0A0A0D] border-y border-[rgba(255,184,0,0.15)] py-20 lg:py-28 overflow-hidden">
  <!-- Glowing Amber Disc Backdrop -->
  <div class="absolute inset-0 bg-radial from-[#FFB800]/6 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title & Subtitle -->
    <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFB800]/10 border border-[#FFB800]/30 text-[#FFB800] text-xs font-black uppercase tracking-widest mb-4">
        <span>📦 THE BOX EXPERIENCE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight font-sans">
        KUTUYA DOLAN <span class="text-[#FFB800]">LEZZET</span>
      </h2>
      <p class="text-zinc-400 mt-3 text-sm sm:text-base font-normal max-w-lg mx-auto">
        Scroll ettikçe makarnanın, tavadaki sıcak sosun ve parmesan bulutunun kutuda nasıl birleştiğini izle.
      </p>
    </div>

    <!-- Pinned Scroll Stage Wrapper -->
    <div id="scroll-pin-wrapper" class="relative flex flex-col lg:flex-row items-center justify-center gap-12 min-h-[580px]">
      
      <!-- Central Interactive SVG Box Container -->
      <div class="relative w-[310px] sm:w-[400px] h-[350px] sm:h-[440px] flex items-center justify-center">
        
        <!-- Amber aura glow behind box -->
        <div class="absolute w-80 h-80 rounded-full bg-[#FFB800]/15 blur-3xl pointer-events-none"></div>

        <!-- Master SVG Box Element -->
        <svg id="box-master-svg" viewBox="0 0 340 360" class="w-full h-full relative z-10 drop-shadow-2xl overflow-visible">
          <defs>
            <linearGradient id="boxOuterGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFB800" />
              <stop offset="100%" stop-color="#D97706" />
            </linearGradient>
            <linearGradient id="boxFlapGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#F59E0B" />
              <stop offset="100%" stop-color="#B45309" />
            </linearGradient>
            <linearGradient id="boxInnerDark" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#141418" />
              <stop offset="100%" stop-color="#1F1F27" />
            </linearGradient>
            <linearGradient id="creamySauce" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFFBEB" />
              <stop offset="50%" stop-color="#F59E0B" />
              <stop offset="100%" stop-color="#DC2626" />
            </linearGradient>
            <linearGradient id="durumPasta" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FEF08A" />
              <stop offset="100%" stop-color="#EAB308" />
            </linearGradient>
          </defs>

          <!-- Floor Shadow -->
          <ellipse cx="170" cy="320" rx="115" ry="22" fill="rgba(0,0,0,0.65)" />

          <!-- Back Interior Of The Box (Visible when empty at 0%) -->
          <polygon id="box-interior" points="75,170 265,170 235,305 105,305" fill="url(#boxInnerDark)" />

          <!-- STAGE 1: First batch of al dente pasta coils (10% - 35%) -->
          <g id="layer-pasta-1" style="transform: translateY(-90px); opacity: 0;">
            <path d="M 110 275 Q 140 250 170 275 Q 205 295 230 270 Q 190 255 145 265 Z" fill="url(#durumPasta)" />
            <path d="M 100 258 Q 150 238 200 258 Q 230 275 240 252 Q 170 240 115 252 Z" fill="#FDE047" />
          </g>

          <!-- STAGE 2: Sauce Flow & Sautéed Mushrooms (40% - 65%) -->
          <g id="layer-pasta-2" style="transform: translateY(-70px); opacity: 0;">
            <path d="M 90 230 Q 170 205 250 230 L 240 275 L 100 275 Z" fill="url(#creamySauce)" opacity="0.95" />
            <path d="M 95 215 Q 130 190 170 210 Q 210 230 245 205 Q 180 185 115 205 Z" fill="#FEF08A" />
            <!-- Real Sautéed Mushroom caps -->
            <ellipse cx="138" cy="222" rx="10" ry="7" fill="#713F12" />
            <ellipse cx="198" cy="216" rx="11" ry="8" fill="#713F12" />
          </g>

          <!-- STAGE 3: Full Mound, Garnish, Basil & Parmesan Flakes (70% - 90%) -->
          <g id="layer-pasta-3" style="transform: translateY(-50px); opacity: 0;">
            <!-- Overflowing pasta dome -->
            <path d="M 72 170 Q 170 120 268 170 Q 235 138 170 138 Q 105 138 72 170 Z" fill="url(#durumPasta)" />
            <!-- Rich sauce glaze on top -->
            <path d="M 95 155 Q 170 132 245 158" stroke="#DC2626" stroke-width="8" stroke-linecap="round" fill="none" />
            <path d="M 115 165 Q 170 146 225 168" stroke="#F59E0B" stroke-width="6" stroke-linecap="round" fill="none" />
            
            <!-- Fresh Basil Leaves & Cherry Tomato -->
            <circle cx="155" cy="144" r="10" fill="#DC2626" />
            <path d="M 180 138 C 170 126, 198 120, 192 144 Z" fill="#16A34A" />
            <path d="M 142 134 C 136 122, 160 118, 154 138 Z" fill="#22C55E" />

            <!-- Hand-shaved Parmesan flakes -->
            <rect x="126" y="148" width="7" height="4" rx="1" fill="#FFFFFF" transform="rotate(15)" />
            <rect x="202" y="152" width="8" height="4" rx="1" fill="#FFFFFF" transform="rotate(-25)" />
            <rect x="172" y="155" width="6" height="5" rx="1" fill="#FFFFFF" transform="rotate(45)" />
          </g>

          <!-- Box Exterior Shell (Cuts pasta clean from outside) -->
          <polygon points="75,170 265,170 235,305 105,305" fill="none" stroke="rgba(255,184,0,0.3)" stroke-width="2" />
          <polygon points="75,170 265,170 235,305 105,305" fill="url(#boxOuterGrad)" opacity="0.97" />
          <polygon points="265,170 292,152 260,288 235,305" fill="#92400E" />

          <!-- Front Brand Logo on Kutu -->
          <rect x="128" y="212" width="84" height="54" rx="8" fill="#0A0A0D" opacity="0.96" />
          <text x="170" y="235" fill="#FFB800" font-size="12" font-weight="900" text-anchor="middle" font-family="sans-serif">KUTUDA</text>
          <text x="170" y="253" fill="#FFFFFF" font-size="12" font-weight="900" text-anchor="middle" font-family="sans-serif">MAKARNA</text>

          <!-- Box Flaps Open (Left & Right) -->
          <polygon id="flap-left" points="75,170 30,115 118,132 108,170" fill="url(#boxFlapGrad)" />
          <polygon id="flap-right" points="265,170 310,115 222,132 232,170" fill="#B45309" />

          <!-- Rising Steam Paths (Appears at 100%) -->
          <g id="layer-steam" style="opacity: 0;">
            <path class="animate-steam-1" d="M 138 115 Q 116 72 138 28" stroke="rgba(255,255,255,0.75)" stroke-width="3" stroke-linecap="round" fill="none" />
            <path class="animate-steam-2" d="M 170 105 Q 192 62 170 18" stroke="rgba(255,255,255,0.85)" stroke-width="3.5" stroke-linecap="round" fill="none" />
            <path class="animate-steam-3" d="M 202 115 Q 180 72 202 28" stroke="rgba(255,255,255,0.75)" stroke-width="3" stroke-linecap="round" fill="none" />
          </g>

          <!-- Fork Landing into Hot Box (Appears at 100%) -->
          <g id="layer-fork" style="transform: translate(25px, -65px) rotate(16deg); opacity: 0;">
            <rect x="190" y="10" width="11" height="95" rx="4" fill="#E4E4E7" />
            <path d="M 182 95 L 209 95 L 205 132 L 186 132 Z" fill="#E4E4E7" />
            <line x1="185" y1="132" x2="185" y2="160" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="192" y1="132" x2="192" y2="165" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="200" y1="132" x2="200" y2="165" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
            <line x1="206" y1="132" x2="206" y2="160" stroke="#D4D4D8" stroke-width="3" stroke-linecap="round" />
          </g>
        </svg>
      </div>

      <!-- Live Stage Tracker & Narrative Card -->
      <div class="w-full lg:w-[440px] bg-[#14141A] border border-zinc-800 rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl relative">
        <!-- Progress Bar Indicator -->
        <div>
          <div class="flex items-center justify-between text-xs font-bold text-zinc-400 mb-2">
            <span id="box-progress-label" class="tracking-wider uppercase">DOLDURMA AŞAMASI</span>
            <span id="box-progress-percent" class="text-[#FFB800] font-mono text-sm font-black">0%</span>
          </div>
          <div class="w-full h-2.5 bg-zinc-800 rounded-full overflow-hidden">
            <div id="box-progress-bar" class="h-full bg-gradient-to-r from-[#FFB800] to-[#F59E0B] w-0 transition-all duration-150"></div>
          </div>
        </div>

        <!-- Dynamic Story Stages -->
        <div class="space-y-4 min-h-[150px]">
          <!-- Stage 0: 0% - 20% -->
          <div id="stage-text-0" class="stage-card">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Adım 1 / 4 • 0%</span>
            <h3 class="text-2xl font-black text-white mt-1">Kutu Boş & Hazır</h3>
            <p class="text-zinc-400 text-sm mt-1 leading-relaxed">
              Özel yalıtımlı kutumuz, makarnanın nemini ve sıcaklığını 30 dakika boyunca ideal dengede korumak üzere açılıyor.
            </p>
          </div>

          <!-- Stage 1: 25% - 50% -->
          <div id="stage-text-1" class="stage-card hidden">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Adım 2 / 4 • 25% - 40%</span>
            <h3 class="text-2xl font-black text-white mt-1">Al Dente Taze Makarna</h3>
            <p class="text-zinc-400 text-sm mt-1 leading-relaxed">
              Kaynar suda tam kıvamında 2 dakika haşlanan taze durum buğdayı makarnası sıcak sıcak kutuya dolmaya başlıyor.
            </p>
          </div>

          <!-- Stage 2: 55% - 80% -->
          <div id="stage-text-2" class="stage-card hidden">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FFB800]">Adım 3 / 4 • 55% - 80%</span>
            <h3 class="text-2xl font-black text-white mt-1">Tavadaki Sıcak Özel Sos</h3>
            <p class="text-zinc-400 text-sm mt-1 leading-relaxed">
              Taze sotelenmiş mantarlar, San Marzano domatesi veya ipeksi krema makarnanın her kıvrımına eşit bağlanıyor.
            </p>
          </div>

          <!-- Stage 3: 85% - 100% -->
          <div id="stage-text-3" class="stage-card hidden space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 font-mono">100% • TAMAMLANDI! 🔥</span>
            <h3 class="text-3xl font-black text-white leading-tight font-sans">
              İŞTE ŞİMDİ OLDU.<br />
              <span class="text-[#FFB800]">KUTU DOLDU!</span>
            </h3>
            <p class="text-zinc-300 text-sm leading-relaxed">
              Taze fesleğen ve parmesan serpildi, buharı tütüyor. Kutunu seç ve lezzetin tadını çıkar.
            </p>
            
            <div class="pt-2">
              <a
                href="/menu"
                class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-[#FFB800] text-[#0A0A0D] font-black text-sm hover:bg-[#F59E0B] shadow-xl shadow-[#FFB800]/25 transition-transform hover:scale-105"
              >
                <span>MENÜDEN KUTUNU SEÇ</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Manual Controls for Keyboard & Touch Accessibility -->
        <div class="pt-4 border-t border-zinc-800 flex items-center justify-between text-xs">
          <span class="text-zinc-500">Aşamaları manuel incele:</span>
          <div class="flex items-center gap-2">
            <button id="btn-step-prev" class="px-3 py-1.5 rounded-lg bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors font-bold cursor-pointer" aria-label="Önceki Aşama">‹ Geri</button>
            <button id="btn-step-next" class="px-3 py-1.5 rounded-lg bg-zinc-800 text-zinc-300 hover:text-white hover:bg-zinc-700 transition-colors font-bold cursor-pointer" aria-label="Sonraki Aşama">İleri ›</button>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- GSAP ScrollTrigger Script -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const pinWrapper = document.getElementById('scroll-pin-wrapper');
  const layer1 = document.getElementById('layer-pasta-1');
  const layer2 = document.getElementById('layer-pasta-2');
  const layer3 = document.getElementById('layer-pasta-3');
  const layerSteam = document.getElementById('layer-steam');
  const layerFork = document.getElementById('layer-fork');
  const flapLeft = document.getElementById('flap-left');
  const flapRight = document.getElementById('flap-right');

  const progressBar = document.getElementById('box-progress-bar');
  const progressPercent = document.getElementById('box-progress-percent');

  const stage0 = document.getElementById('stage-text-0');
  const stage1 = document.getElementById('stage-text-1');
  const stage2 = document.getElementById('stage-text-2');
  const stage3 = document.getElementById('stage-text-3');

  function updateStageUI(progress: number) {
    const percent = Math.min(100, Math.max(0, Math.round(progress * 100)));
    if (progressBar) progressBar.style.width = `${percent}%`;
    if (progressPercent) progressPercent.innerText = `${percent}%`;

    const stages = [stage0, stage1, stage2, stage3];
    stages.forEach(s => s?.classList.add('hidden'));

    if (progress < 0.25) {
      stage0?.classList.remove('hidden');
    } else if (progress < 0.55) {
      stage1?.classList.remove('hidden');
    } else if (progress < 0.85) {
      stage2?.classList.remove('hidden');
    } else {
      stage3?.classList.remove('hidden');
    }
  }

  if (prefersReducedMotion) {
    // If reduced motion is requested, immediately show 100% full state
    if (layer1) { layer1.style.opacity = '1'; layer1.style.transform = 'translateY(0)'; }
    if (layer2) { layer2.style.opacity = '1'; layer2.style.transform = 'translateY(0)'; }
    if (layer3) { layer3.style.opacity = '1'; layer3.style.transform = 'translateY(0)'; }
    if (layerSteam) layerSteam.style.opacity = '1';
    if (layerFork) { layerFork.style.opacity = '1'; layerFork.style.transform = 'translate(0, 0) rotate(12deg)'; }
    updateStageUI(1);
  } else if (pinWrapper) {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#pasta-box-experience',
        start: 'top top+=80',
        end: '+=1300',
        pin: true,
        scrub: 0.5,
        anticipatePin: 1,
        onUpdate: (self) => {
          updateStageUI(self.progress);
        }
      }
    });

    // 0% -> 25%: Flaps open, Layer 1 falls with natural bounce
    tl.to(flapLeft, { rotation: -16, transformOrigin: 'bottom right', duration: 1 }, 0)
      .to(flapRight, { rotation: 16, transformOrigin: 'bottom left', duration: 1 }, 0)
      .to(layer1, { y: 0, opacity: 1, duration: 1.5, ease: 'bounce.out' }, 0.4)

    // 25% -> 60%: Layer 2 (sauce & sautéed mushrooms) flows into box
      .to(layer2, { y: 0, opacity: 1, duration: 1.8, ease: 'power2.out' }, 1.8)

    // 60% -> 85%: Layer 3 (garnish, cherry tomato & basil) crowns the box
      .to(layer3, { y: 0, opacity: 1, duration: 2, ease: 'back.out(1.3)' }, 3.4)

    // 85% -> 100%: Steam rises and fork lands into box
      .to(layerSteam, { opacity: 1, duration: 1 }, 4.8)
      .to(layerFork, { x: 0, y: 0, rotation: 12, opacity: 1, duration: 1.2, ease: 'power2.out' }, 4.9);

    // Manual step buttons support
    let currentStep = 0;
    const stepProgress = [0, 0.35, 0.70, 1.0];

    document.getElementById('btn-step-next')?.addEventListener('click', () => {
      currentStep = Math.min(3, currentStep + 1);
      tl.progress(stepProgress[currentStep]);
      updateStageUI(stepProgress[currentStep]);
    });

    document.getElementById('btn-step-prev')?.addEventListener('click', () => {
      currentStep = Math.max(0, currentStep - 1);
      tl.progress(stepProgress[currentStep]);
      updateStageUI(stepProgress[currentStep]);
    });
  }
</script>
