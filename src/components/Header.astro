---
import OnlineOrderModal from './OnlineOrderModal.astro';
import BranchSelectorModal from './branches/BranchSelectorModal.astro';

interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { name: 'Ana Sayfa', href: '/' },
  { name: 'Menü', href: '/menu' },
  { name: 'Hikayemiz', href: '/hakkimizda' },
  { name: 'Şubeler', href: '/subeler' },
  { name: 'Franchise', href: '/franchise' },
  { name: 'İletişim', href: '/iletisim' },
];
---

<!-- Sticky, Minimal & Premium Navbar -->
<header id="site-header" class="sticky top-0 z-40 bg-[#FBF9F5]/90 backdrop-blur-md border-b border-stone-200/80 transition-all duration-300 w-full">
  
  <!-- Top Utility Bar (Subtle Luxury Strip) -->
  <div id="top-utility-bar" class="hidden md:block bg-[#161B22] text-stone-300 text-xs py-2 px-4 border-b border-stone-800">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-6">
        <a href="tel:+903625000101" class="flex items-center gap-1.5 hover:text-[#FFB800] transition-colors">
          <span>📞</span>
          <span class="font-mono font-bold">0 (362) 500 01 01</span>
        </a>
        <span class="text-stone-700">|</span>
        <span class="flex items-center gap-1.5">
          <span>🕒</span>
          <span>Her Gün: <strong>11:00 - 01:00</strong></span>
        </span>
        <span class="text-stone-700">|</span>
        <span class="flex items-center gap-1.5 text-emerald-400 font-bold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Şubelerimiz Açık (Sıcak Gel-Al & Kurye)</span>
        </span>
      </div>

      <div class="flex items-center gap-5">
        <!-- Crisp Vector SVG Instagram Logo -->
        <a
          href="https://instagram.com/kutudamakarna"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#FFB800] transition-colors flex items-center gap-1.5 font-semibold text-stone-200"
          aria-label="Instagram Hesabımız"
        >
          <svg class="w-3.5 h-3.5 fill-current text-[#E4405F]" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>@kutudamakarna</span>
        </a>
        <span class="text-stone-700">|</span>
        <a href="/franchise" class="text-[#FFB800] font-bold hover:underline">
          Franchise Fırsatı →
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar Container -->
  <div id="navbar-main" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 transition-all duration-300 flex items-center justify-between">
    
    <!-- Sol: MARKA LOGOSU -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none rounded-xl p-1 shrink-0" aria-label="Kutuda Makarna Ana Sayfa">
      <div class="relative w-9 h-9 sm:w-10 sm:h-10 bg-[#FFB800] rounded-xl flex items-center justify-center text-[#1C1917] font-black shadow-md shadow-amber-500/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
          <path d="m3.3 7 8.7 5 8.7-5" />
          <path d="M12 12v10" />
        </svg>
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-1">
          <span class="font-black text-lg sm:text-xl tracking-tight text-[#1C1917] uppercase font-sans group-hover:text-[#D97706] transition-colors">Kutuda</span>
          <span class="font-black text-lg sm:text-xl tracking-wider text-[#D97706] uppercase font-sans">Makarna</span>
        </div>
        <span class="text-[9px] tracking-widest text-stone-500 uppercase font-black -mt-1">Taze Makarna</span>
      </div>
    </a>

    <!-- Orta: Navigasyon Linkleri -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Ana Menü">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-sm font-bold tracking-tight transition-all relative py-1 hover:text-[#D97706] ${
              isActive ? 'text-[#D97706]' : 'text-stone-700'
            }`}
          >
            {link.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[#D97706] rounded-full" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Sağ: "Online Sipariş" & "Şubeler" Butonları (Rezervasyon TAMAMEN kaldırıldı) -->
    <div class="hidden sm:flex items-center gap-3 shrink-0">
      <a
        href="/subeler"
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl border border-stone-300 hover:border-amber-500 bg-white hover:bg-amber-50/60 text-[#1C1917] font-bold text-xs uppercase tracking-wider transition-all shadow-2xs"
      >
        <span>📍 Şubeler</span>
      </a>

      <button
        type="button"
        data-open-online-order-modal
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-[#1C1917] hover:bg-[#D97706] text-white font-black text-xs uppercase tracking-wider transition-all hover:scale-102 active:scale-98 shadow-md cursor-pointer"
      >
        <span>🛵 Online Sipariş</span>
      </button>
    </div>

    <!-- Mobile Menu Hamburger & Quick Order Button -->
    <div class="flex items-center lg:hidden gap-2">
      <button
        type="button"
        data-open-online-order-modal
        class="px-3 py-1.5 rounded-lg bg-[#FFB800] text-[#1C1917] font-black text-xs uppercase"
      >
        Sipariş
      </button>

      <button
        type="button"
        id="mobile-menu-button"
        class="p-2 rounded-xl text-stone-700 hover:text-stone-900 hover:bg-stone-100 focus:outline-none"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Menüyü Aç"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#FAF8F5] border-b border-stone-200 px-5 pt-3 pb-6 space-y-3 shadow-xl">
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-2.5 rounded-xl text-base font-bold transition-colors ${
              isActive ? 'bg-amber-100 text-[#B45309]' : 'text-stone-800 hover:bg-stone-100'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </div>

    <div class="pt-3 border-t border-stone-200 flex flex-col gap-2">
      <a
        href="https://instagram.com/kutudamakarna"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 py-2.5 rounded-xl bg-white border border-stone-300 text-stone-800 text-xs font-bold"
      >
        <svg class="w-4 h-4 fill-current text-[#E4405F]" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        <span>@kutudamakarna Instagram</span>
      </a>

      <button
        type="button"
        data-open-online-order-modal
        class="w-full text-center py-3 rounded-xl bg-[#1C1917] text-white text-xs font-black uppercase shadow-md cursor-pointer"
      >
        🛵 Online Sipariş Ver
      </button>
    </div>
  </div>
</header>

<!-- Modals -->
<OnlineOrderModal />
<BranchSelectorModal />

<script>
  function setupHeader() {
    const header = document.getElementById('site-header');
    const navbarMain = document.getElementById('navbar-main');
    const mobileBtn = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    // Scroll shrink & blur enhancement
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        navbarMain?.classList.remove('h-20');
        navbarMain?.classList.add('h-16');
        header?.classList.add('shadow-md', 'bg-[#FBF9F5]/95');
      } else {
        navbarMain?.classList.remove('h-16');
        navbarMain?.classList.add('h-20');
        header?.classList.remove('shadow-md');
      }
    });

    // Mobile Drawer Toggle
    mobileBtn?.addEventListener('click', () => {
      const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
      mobileBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu?.classList.toggle('hidden');
      menuIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
</script>
