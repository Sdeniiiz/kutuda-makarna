---
interface Props {
  activePath?: string;
}

const { activePath = '/' } = Astro.props;

const navLinks = [
  { name: 'Menü', href: '/menu' },
  { name: 'Şubelerimiz', href: '/subeler' },
  { name: 'Neden Kutu?', href: '/hakkimizda' },
  { name: 'Makarna Rehberi', href: '/makarna' },
  { name: 'İletişim', href: '/iletisim' },
];
---

<header class="sticky top-0 z-50 bg-[#0E0E10]/90 backdrop-blur-md border-b border-[rgba(255,184,0,0.15)] transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#FFB800] rounded-lg p-1" aria-label="Kutuda Makarna Ana Sayfa">
      <!-- Stylized Yellow Box Icon -->
      <div class="relative w-10 h-10 bg-[#FFB800] rounded-xl flex items-center justify-center text-[#0E0E10] font-black shadow-lg shadow-[#FFB800]/20 group-hover:scale-105 transition-transform duration-200">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Box isometric -->
          <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
          <path d="m3.3 7 8.7 5 8.7-5" />
          <path d="M12 12v10" />
        </svg>
      </div>

      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-xl tracking-tight text-white uppercase font-sans group-hover:text-[#FFB800] transition-colors">Kutuda</span>
          <span class="font-black text-xl tracking-wider text-[#FFB800] uppercase font-sans">Makarna</span>
        </div>
        <span class="text-[10px] tracking-widest text-zinc-400 uppercase font-medium -mt-1">Lezzet Kutuda Saklı</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Ana Menü">
      {navLinks.map((link) => {
        const isActive = activePath === link.href || (link.href !== '/' && activePath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-sm font-semibold transition-all relative py-1 hover:text-[#FFB800] ${
              isActive ? 'text-[#FFB800]' : 'text-zinc-300'
            }`}
          >
            {link.name}
            {isActive && (
              <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[#FFB800] rounded-full" />
            )}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-4">
      <a
        href="/subeler"
        class="inline-flex items-center gap-2 px-3 py-2 text-xs font-semibold text-zinc-300 hover:text-white transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Şubeler Açık</span>
      </a>

      <a
        href="/menu"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#FFB800] text-[#0E0E10] font-bold text-sm hover:bg-[#F59E0B] shadow-md shadow-[#FFB800]/25 transition-all hover:scale-105 active:scale-95"
      >
        <span>Kutunu Seç</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden p-2 rounded-lg text-zinc-300 hover:text-white hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-[#FFB800]"
      aria-label="Menüyü Aç"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#141418] border-b border-zinc-800 px-4 pt-3 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2 rounded-lg text-base font-medium text-zinc-300 hover:text-white hover:bg-zinc-800/80 transition-colors"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-zinc-800 flex flex-col gap-2">
      <a
        href="/subeler"
        class="w-full text-center py-2.5 rounded-lg border border-zinc-700 text-sm font-semibold text-zinc-200 hover:border-[#FFB800] transition-colors"
      >
        📍 En Yakın Şubeyi Bul
      </a>
      <a
        href="/menu"
        class="w-full text-center py-2.5 rounded-lg bg-[#FFB800] text-[#0E0E10] text-sm font-bold shadow-md hover:bg-[#F59E0B]"
      >
        Kutunu Seç & Menüyü Gör
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconBars = document.getElementById('menu-icon-bars');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && iconBars && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconBars.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
