---
import type { BranchAggregate } from '../../types/branch';

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
---

<div class="relative rounded-3xl overflow-hidden bg-white border border-stone-200/90 shadow-sm p-6 sm:p-10 mb-10">
  <!-- Subtle Amber Ambient Background -->
  <div class="absolute -right-20 -top-20 w-80 h-80 bg-amber-400/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
    <!-- Left Column: Copy & Live Badges -->
    <div class="lg:col-span-7 space-y-4">
      <div class="flex items-center gap-2.5 flex-wrap">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200 text-xs font-bold">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Şu An Açık • Sıcak Servis</span>
        </span>

        <span class="inline-flex items-center px-3 py-1 rounded-full bg-stone-100 text-stone-700 border border-stone-200 text-xs font-semibold">
          {branch.info?.conceptType || 'Fast Casual Kiosk'}
        </span>

        <span class="text-xs font-mono text-stone-400 font-medium">
          #{branch.entity?.branchCode || branch.id}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-[#1C1917] tracking-tight font-sans leading-tight">
        {branch.hero?.headline || `KUTUDA MAKARNA ${branch.name.toUpperCase()}`}
      </h1>

      <p class="text-stone-600 text-base sm:text-lg leading-relaxed">
        {branch.hero?.subline || branch.info?.description || `${branch.district} bölgesinde taze al dente makarna hamuru, sıcacık soslar ve 3 dakikada hızlı teslimat.`}
      </p>

      <!-- Quick Action Buttons -->
      <div class="pt-2 flex flex-wrap gap-3">
        <a
          href={branch.hero?.primaryCtaUrl || `tel:${branch.contact?.phone || branch.phone}`}
          class="px-6 py-3 rounded-2xl bg-[#FFB800] hover:bg-[#F59E0B] text-[#1C1917] font-black text-sm shadow-md shadow-amber-500/20 transition-all hover:scale-102 active:scale-98"
        >
          {branch.hero?.primaryCtaLabel || '📞 HEMEN SİPARİŞ VER'}
        </a>

        <a
          href={branch.location?.googleMapsUrl || branch.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-2xl bg-white border border-stone-300 hover:border-stone-400 text-stone-800 font-bold text-sm transition-all hover:bg-stone-50 shadow-xs"
        >
          🗺️ YOL TARİFİ AL
        </a>
      </div>
    </div>

    <!-- Right Column: Store / Concept Visual -->
    <div class="lg:col-span-5 relative">
      <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden border border-stone-200 shadow-md">
        <img
          src={branch.branding?.heroImage?.desktop || branch.image}
          alt={branch.branding?.heroImage?.alt || `${branch.name} şube görünümü`}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
        <div class="absolute bottom-3 left-3 right-3 text-white text-xs font-bold backdrop-blur-xs px-3 py-1.5 rounded-xl bg-black/40 border border-white/20">
          📍 {branch.district}, Samsun
        </div>
      </div>
    </div>
  </div>
</div>
