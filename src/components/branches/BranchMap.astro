---
import type { BranchLocation } from '../../types/branch';

interface Props {
  location: BranchLocation;
  branchName: string;
}

const { location, branchName } = Astro.props;
---

<div class="space-y-6">
  <!-- Directions Guide -->
  <div class="space-y-3">
    <h2 class="text-xl font-black text-[#1C1917] uppercase tracking-wider border-l-3 border-[#D97706] pl-3.5">
      Nasıl Gidilir? (Ulaşım Rehberi)
    </h2>
    <div class="bg-white border border-stone-200/80 rounded-2xl p-6 text-sm text-stone-700 leading-relaxed shadow-xs">
      <p>{location.directionsGuide}</p>
    </div>
  </div>

  <!-- Nearby Landmarks (Local SEO Booster) -->
  {location.nearbySpots && location.nearbySpots.length > 0 && (
    <div class="space-y-3">
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-500">
        Yakındaki Önemli Noktalar & Duraklar
      </h3>
      <div class="flex flex-wrap gap-2">
        {location.nearbySpots.map((spot) => (
          <span class="px-3.5 py-1.5 rounded-full bg-stone-100 border border-stone-200 text-xs font-medium text-stone-700">
            📍 {spot}
          </span>
        ))}
      </div>
    </div>
  )}

  <!-- Google Maps CTA Box -->
  <div class="p-6 rounded-2xl bg-amber-50/70 border border-amber-200/90 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <h4 class="text-sm font-black text-[#1C1917]">Google Haritalar'da Görüntüle</h4>
      <p class="text-xs text-stone-600">Tek dokunuşla navigasyonu başlatın ve en hızlı rotayla şubemize gelin.</p>
    </div>
    <a
      href={location.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="px-5 py-2.5 rounded-xl bg-[#1C1917] hover:bg-stone-800 text-white font-bold text-xs transition-colors shrink-0 shadow-xs"
    >
      Yol Tarifi Başlat ↗
    </a>
  </div>
</div>
