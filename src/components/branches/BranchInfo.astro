---
import type { BranchAggregate } from '../../types/branch';

interface Props {
  branch: BranchAggregate;
}

const { branch } = Astro.props;
---

<div class="bg-white border border-stone-200/90 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
  <div class="border-b border-stone-100 pb-4">
    <h2 class="text-xl font-black text-[#1C1917] tracking-tight flex items-center gap-2">
      <span>📍</span>
      <span>Şube Bilgileri & İletişim</span>
    </h2>
  </div>

  <!-- Address -->
  <div class="flex items-start gap-4">
    <div class="w-10 h-10 rounded-2xl bg-amber-100/70 border border-amber-200/80 flex items-center justify-center text-[#B45309] shrink-0 text-lg">
      📍
    </div>
    <div class="space-y-1">
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-500">Açık Adres</h3>
      <p class="text-sm font-semibold text-[#1C1917] leading-relaxed">{branch.location?.address || branch.address}</p>
      {branch.location?.parkingInfo && (
        <p class="text-xs text-stone-500 flex items-center gap-1.5 pt-1">
          <span>🚗</span>
          <span>{branch.location.parkingInfo}</span>
        </p>
      )}
    </div>
  </div>

  <!-- Phone & Ordering Line -->
  <div class="flex items-start gap-4">
    <div class="w-10 h-10 rounded-2xl bg-amber-100/70 border border-amber-200/80 flex items-center justify-center text-[#B45309] shrink-0 text-lg">
      📞
    </div>
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-500">Sipariş & Bilgi Hattı</h3>
      <a href={`tel:${branch.contact?.phone || branch.phone}`} class="text-lg font-black text-[#D97706] hover:underline font-mono mt-0.5 block">
        {branch.contact?.phoneDisplay || branch.phoneDisplay}
      </a>
      <span class="text-[11px] text-stone-500">Gel-Al siparişleriniz için arayarak sıra beklemeden teslim alabilirsiniz.</span>
    </div>
  </div>

  <!-- Working Hours -->
  <div class="flex items-start gap-4">
    <div class="w-10 h-10 rounded-2xl bg-amber-100/70 border border-amber-200/80 flex items-center justify-center text-[#B45309] shrink-0 text-lg">
      🕒
    </div>
    <div class="space-y-1">
      <h3 class="text-xs font-bold uppercase tracking-wider text-stone-500">Çalışma Saatleri</h3>
      <div class="text-sm text-stone-700">
        <span class="font-bold text-[#1C1917]">Hafta İçi:</span> {branch.hours?.weekdays || branch.workingHours.weekdays}
      </div>
      <div class="text-sm text-stone-700">
        <span class="font-bold text-[#1C1917]">Hafta Sonu:</span> {branch.hours?.weekend || branch.workingHours.weekend}
      </div>
      {(branch.hours?.note || branch.workingHours.note) && (
        <p class="text-xs text-[#B45309] pt-1 font-medium">💡 {branch.hours?.note || branch.workingHours.note}</p>
      )}
    </div>
  </div>

  <!-- Service Speed Badges -->
  <div class="pt-4 border-t border-stone-100 flex items-center gap-4 text-xs font-semibold text-stone-600 flex-wrap">
    <div class="flex items-center gap-1.5">
      <span class="text-[#D97706]">⚡</span>
      <span>Gel-Al Hazırlık: <strong>{branch.orderSettings?.estimatedPickupMinutes || 5} dk</strong></span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[#D97706]">🛵</span>
      <span>Ortalama Kurye: <strong>{branch.orderSettings?.estimatedDeliveryMinutes || 30} dk</strong></span>
    </div>
  </div>
</div>
